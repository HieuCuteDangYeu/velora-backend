generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/reel-indexing-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("REEL_INDEXING_DATABASE_URL")
}

enum IndexJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum IndexCheckpointStage {
  TRANSCRIBING_AUDIO_SEGMENTS
  MERGING_TRANSCRIPT
  EXTRACTING_METADATA
  BUILDING_SECTIONS
  BUILDING_CHUNKS
  EMBEDDING
  VALIDATING
  PERSISTING
}

enum AudioSegmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IndexDocumentKind {
  REEL
  SECTION
  CHUNK
  VISUAL_SCENE
}

enum EvidenceQuality {
  VERIFIED
  LOW_CONFIDENCE
  METADATA_ONLY
}

model IndexingAttempt {
  indexAttemptId        String               @id
  jobId                 String               @unique
  reelId                String
  mediaAttemptId        String
  indexVersion          String
  status                IndexJobStatus       @default(PROCESSING)
  stage                 IndexCheckpointStage @default(TRANSCRIBING_AUDIO_SEGMENTS)
  mergedTranscript      String?              @db.Text
  mergedTranscriptHash  String?
  mergeAlgorithmVersion String?
  mergedSegments        Json?
  extractedMetadata     Json?
  sections              Json?
  chunks                Json?
  documentDrafts        Json?
  lastError             String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  audioSegments AudioSegmentCheckpoint[]

  @@index([reelId])
  @@index([status, updatedAt])
}

model LangGraphCheckpoint {
  threadId            String
  checkpointNamespace String
  checkpointId        String
  parentCheckpointId  String?
  checkpointType      String
  checkpoint          Bytes
  metadataType        String
  metadata            Bytes
  createdAt           DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId])
  @@index([threadId, checkpointNamespace, createdAt])
}

model LangGraphCheckpointWrite {
  threadId            String
  checkpointNamespace String
  checkpointId        String
  taskId              String
  writeIndex          Int
  channel             String
  valueType           String
  value               Bytes
  createdAt           DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId, taskId, writeIndex])
  @@index([threadId, checkpointNamespace, checkpointId])
}

model EmbeddingCacheEntry {
  cacheKey            String            @id
  stableItemId        String
  documentKind        IndexDocumentKind
  embeddingInputHash  String
  embeddingProvider   String
  embeddingModel      String
  embeddingDimensions Int
  embeddingVersion    String
  indexVersion        String
  chunkingVersion     String
  summaryVersion      String
  embedding           Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([stableItemId])
  @@index([embeddingInputHash, embeddingVersion])
  @@index([indexVersion, chunkingVersion, summaryVersion])
}

model AudioSegmentCheckpoint {
  id                    String             @id @default(uuid())
  indexAttemptId        String
  segmentNumber         Int
  artifactKey           String
  artifactChecksum      String
  startMs               Int
  endMs                 Int
  overlapBeforeMs       Int
  provider              String?
  transcriptionModel    String?
  transcriptionVersion  String?
  transcriptionIdentity String?
  status                AudioSegmentStatus @default(PENDING)
  attemptCount          Int                @default(0)
  transcriptText        String?            @db.Text
  transcriptSegments    Json?
  lastError             String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  checkpoint IndexingAttempt @relation(fields: [indexAttemptId], references: [indexAttemptId], onDelete: Cascade)

  @@unique([indexAttemptId, segmentNumber])
  @@index([indexAttemptId, status])
}

model ReelDocument {
  rowId                  String                      @id @default(uuid())
  id                     String
  reelId                 String
  indexAttemptId         String
  isActive               Boolean                     @default(false)
  isLegacyImport         Boolean                     @default(false)
  userId                 String
  parentId               String?
  ordinal                Int
  title                  String?
  description            String?                     @db.Text
  evidenceText           String?                     @db.Text
  retrievalText          String                      @db.Text
  derivedSummary         String?                     @db.Text
  sourceSectionIds       String[]
  sourceSegmentIds       String[]
  sourceAudioArtifactIds String[]
  evidenceHash           String?
  retrievalHash          String
  evidenceQuality        EvidenceQuality
  transcriptVersion      String?
  sectioningVersion      String
  tokenCount             Int
  tags                   String[]
  startTime              Float?
  endTime                Float?
  sourceDurationMs       Int
  sourceOrientation      String
  sourceLengthClass      String
  embedding              Unsupported("vector(1024)")
  searchVector           Unsupported("tsvector")?
  embeddingProvider      String
  embeddingModel         String
  embeddingDimensions    Int
  embeddingVersion       String
  embeddingInputHash     String
  indexVersion           String
  chunkingVersion        String
  summaryVersion         String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([id, indexAttemptId])
  @@unique([reelId, indexAttemptId])
  @@index([reelId, isActive])
  @@index([userId, isActive])
  @@index([sourceLengthClass, isActive])
  @@index([reelId, indexAttemptId, ordinal])
}

