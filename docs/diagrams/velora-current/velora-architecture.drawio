ies it to a semantic row.&lt;br&gt;attempt: indexAttemptId; Cascade delete (declared SQL FK); checkpoint: threadId + namespace + checkpointId (logical) (scalar-ID association; no declared FK); attempt context: thread identity contains reelId:attemptId:indexVersion&lt;br&gt;(scalar-ID association; no declared FK)" vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#fff8ed;strokeColor=#687782;"><mxGeometry as="geometry" x="35" y="1210.024" width="1748.0159999999998" height="148" /></mxCell></root></mxGraphModel></diagram><diagram id="16-ai-conversation" name="16 · AI conversation, memory and shared-Reel entities"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="2495" pageHeight="1287.976" shadow="0"><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="E05-ai-conversation-e1" value="" edge="1" parent="1" source="Message" target="Conversation" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#687782;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.8399999999999997;exitY=1.0;entryX=0.5;entryY=0.0;endArrow=none;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/conversation-service/prisma/schema.prisma:95-147&quot;]" relationKind="association" enforcement="declared relation"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1217.5839999999998" y="773.374944" /><mxPoint x="1067.984" y="773.374944" /></Array></mxGeometry></mxCell><mxCell id="E05-ai-conversation-e1_label" value="conversation" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=0;fontFamily=Arial;"><mxGeometry as="geometry" x="1377.504" y="791.525808" width="295.52" height="32" /></mxCell><mxCell id="E05-ai-conversation-e1_multiplicity0" value="0.