ma.prisma:17-44&quot;]" semanticId="Friendship" domainRole="entity"><mxGeometry as="geometry" x="937.9920000000001" y="160.00639999999999" width="440" height="205" /></mxCell><mxCell id="Friendship_fields" value="id: String {PK}&lt;br&gt;requesterId: String&lt;br&gt;recipientId: String&lt;br&gt;userOneId: String&lt;br&gt;userTwoId: String&lt;br&gt;status: FriendshipStatus" vertex="1" parent="Friendship" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeColor=none;fillColor=none;fontFamily=Arial;"><mxGeometry as="geometry" x="0" y="69" width="440" height="136" /></mxCell><mxCell id="UserBlock" value="&lt;b&gt;UserBlock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#ffffff&quot;&gt;friend service · PostgreSQL schema&lt;/span&gt;" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;startSize=69;fontSize=18;spacingLeft=14;fillColor=#315875;swimlaneFillColor=#ffffff;strokeColor=#687782;childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Arial;fontColor=#ffffff;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/friend-service/prisma/schema.prisma:35-44&quot;]" semanticId="UserBlock" domainRole="entity"><mxGeometry as="geometry" x="1536.0240000000001" y="190.00639999999999" width="440" height="145" /></mxCell><mxCell id="UserBlock_fields" value="blockerId: String&lt;br&gt;blockedUserId: String&lt;br&gt;createdAt: DateTime" vertex="1" parent="UserBlock" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeColor=none;fillColor=none;fontFamily=Arial;"><mxGeometry as="geometry" x="0" y="69" width="440" height="76" /></mxCell><mxCell id="title" value="12 · Identity and social entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontStyle=1;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="17" width="2844.016" height="45" /></mxCell><mxCell id="subtitle" value="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="65" width="2844.016" height="65" /></mxCell><mxCell id="notes" value="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys.&lt;br&gt;Friendship pair UNIQUE(userOneId,userTwoId); UserBlock PK(blockerId,blockedUserId); UserRole UNIQUE(userId,roleId). Cross-service user references and refresh replacement IDs are not database foreign keys. Multiplicity describes each named role; two-role links do not mean one shared user.&lt;br&gt;role: roleId to id (declared SQL FK); user: userId to id (logical) (scalar-ID association; no declared FK); token owner: userId to id (logical) (scalar-ID association; no declared FK); requester: requesterId to User.id (scalar-ID association; no declared FK); recipient: recipientId to User.id; logical scalar IDs, no cross-service FK; blocker: blockerId to User.id (scalar-ID&lt;br&gt;association; no declared FK); blocked user: blockedUserId to User.id; logical scalar IDs, no cross-service FK; successor: replacedByTokenId: optional logical successor (scalar-ID association; no declared FK)" vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#fff8ed;strokeColor=#687782;"><mxGeometry as="geometry" x="35" y="965.0079999999998" width="2844.016" height="108" /></mxCell><mxCell 