" width="440" height="136" /></mxCell><mxCell id="ReelViewSession" value="&lt;b&gt;ReelViewSession&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;startSize=52;fontSize=16;spacingLeft=10;fillColor=light-dark(#ffffff,#181818);swimlaneFillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Arial;fontColor=light-dark(#202020,#eeeeee);fontStyle=0;strokeWidth=1;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:296-348&quot;]" semanticId="ReelViewSession" domainRole="entity" tooltip="ReelViewSession   content service · PostgreSQL schema"><mxGeometry as="geometry" x="1367.0320000000002" y="575.012" width="440" height="128" /></mxCell><mxCell id="ReelViewSession_fields" value="userId: String&lt;br&gt;reelId: String&lt;br&gt;playbackSessionId: String" vertex="1" parent="ReelViewSession" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=light-dark(#202020,#eeeeee);spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="76" /></mxCell><mxCell id="OutboxEvent" value="&lt;b&gt;OutboxEvent&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;startSize=52;fontSize=16;spacingLeft=10;fillColor=light-dark(#ffffff,#181818);swimlaneFillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Arial;fontColor=light-dark(#202020,#eeeeee);fontStyle=0;strokeWidth=1;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:311-348&quot;]" semanticId="OutboxEvent" domainRole="entity" tooltip="OutboxEvent   content service · PostgreSQL schema"><mxGeometry as="geometry" x="1886.008" y="545.012" width="440" height="188" /></mxCell><mxCell id="OutboxEvent_fields" value="id: String {PK}&lt;br&gt;aggregateType: String&lt;br&gt;aggregateId: String&lt;br&gt;eventType: String&lt;br&gt;claimToken: String [0..1]&lt;br&gt;publishedAt: DateTime [0..1]" vertex="1" parent="OutboxEvent" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=light-dark(#202020,#eeeeee);spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="136" /></mxCell><mxCell id="title" value="13 · Reel, Series and sharing entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=24;fontStyle=1;align=left;fontColor=light-dark(#202020,#eeeeee);fillColor=none;"><mxGeometry as="geometry" x="35" y="17" width="2425.968" height="45" /></mxCell><mxCell id="notes" value="UNIQUE(userId, publishIntentId): one logical Reel per owner / publish action.&lt;br&gt;Fingerprint rejects conflicting intent reuse; different intent permits the same source video.&lt;br&gt;Upload adoption uses owner + publishIntentId + mediaKey. Attempt leases correlate by reelId / attemptId.&lt;br&gt;These lease correlations are logical scalar IDs, not declared foreign keys.&lt;br&gt;Series deletion sets the optional Reel link to null; declared Reel references cascade. Outbox/session links are logical.&lt;br&gt;Subtitle tracks cascade with their Reel. Rerank exposure rows are experiment measurements keyed by feed session and Reel; they are not part of the Reel aggregate." vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);"><mxGeometry as="geometry" x="35" y="1850" width="1450" height="190" /></mxCell><mxCell id="ReelUploadLease" value="&lt;b&gt;ReelUploadLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);fontFamily=Arial;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:170-199&quot;]"><mxGeometry x="35" y="1540" width="440" height="252" as="geometry" /></mxCell><mxCell id="ReelUploadLease_fields" value="id: String {PK}&lt;br&gt;userId: String&lt;br&gt;publishIntentId: String&lt;br&gt;mediaKey: String&lt;br&gt;fileType: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;adoptedAt: DateTime [0..1]&lt;br&gt;cancelledAt: DateTime [0..1]&lt;br&gt;cleanupClaimedAt: DateTime [0..1]&lt;br&gt;cleanupCompletedAt: DateTime [0..1]" vertex="1" parent="ReelUploadLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=15;fontColor=light-dark(#202020,#eeeeee);fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="200" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease" value="&lt;b&gt;ReelMediaAttemptLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);fontFamily=Arial;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:170-199&quot;]"><mxGeometry x="550" y="1540" width="440" height="148" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease_fields" value="attemptId: String {PK}&lt;br&gt;reelId: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;completedAt: DateTime [0..1]" vertex="1" parent="ReelMediaAttemptLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=15;fontColor=light-dark(#202020,#eeeeee);fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="96" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="14-semantic-hierarchy" name="14 · Semantic evidence entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="1469.0" pageHeight="1586.9840000000002" shadow="0" adaptiveColors="auto" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. {xor}: each chunk has either a section parent or a document parent; both links require the same indexAttemptId. Chunk has one parent selected by strategy: section OR document. The two optional parent links are alternatives, not simultaneous parents. Semantic tables use rowId PK and UNIQUE(id,indexAttemptId). Historical candidates can exist; retrieval serves accepted active rows.  Migrations declare partial uniqueness for active rows: at most one active ReelDocument per Reel, and one active section/chunk/scene per stable id. Live migration application is not probed. reel: reelId: cross-service reference (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); section parent: long-form chunk: parentId = sectionId (scalar-ID association; no declared FK); document parent: short/document chunk: parentId = reelDocumentId (scalar-ID association; no declared FK)"><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="E03-semantic-