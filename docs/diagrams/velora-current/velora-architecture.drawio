idth="440" height="185" /></mxCell><mxCell id="ReelVisualScene_fields" value="rowId: String {PK}&lt;br&gt;id: String&lt;br&gt;parentId: String&lt;br&gt;indexAttemptId: String&lt;br&gt;isActive: Boolean" vertex="1" parent="ReelVisualScene" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeColor=none;fillColor=none;fontFamily=Arial;"><mxGeometry as="geometry" x="0" y="69" width="440" height="116" /></mxCell><mxCell id="title" value="14 · Semantic evidence entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontStyle=1;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="17" width="1399.032" height="45" /></mxCell><mxCell id="subtitle" value="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="65" width="1399.032" height="65" /></mxCell><mxCell id="notes" value="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ}&lt;br&gt;are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. {xor}: each chunk has either a section parent or a&lt;br&gt;document parent; both links require the same indexAttemptId.&lt;br&gt;Chunk has one parent selected by strategy: section OR document. The two optional parent links are alternatives, not simultaneous parents. Semantic tables use rowId PK and&lt;br&gt;UNIQUE(id,indexAttemptId). Historical candidates can exist; retrieval serves accepted active rows.  Migrations declare partial uniqueness for active rows: at most one active ReelDocument&lt;br&gt;per Reel, and one active section/chunk/scene per stable id. Live migration application is not probed.&lt;br&gt;reel: reelId: cross-service reference (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); document:&lt;br&gt;parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); section parent: long-form chunk: parentId = sectionId (scalar-ID association; no declared FK); document&lt;br&gt;parent: short/document chunk: parentId = reelDocumentId (scalar-ID association; no declared FK)" vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#fff8ed;strokeColor=#687782;"><mxGeometry as="geometry" x="35" y="1474.9840000000002" width="1399.032" height="208" /></mxCell></root></mxGraphModel></diagram><diagram id="15-index-state" name="15 · Indexing attempt and reusable state"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1818" pageHeight="1388.024" shadow="0"><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="E04-index-state-e1" value="" edge="1" parent="1" source="AudioSegmentCheckpoint" target="IndexingAttempt" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#687782;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;entryX=0.1600000000000001;entryY=0.0;endArrow=none;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/reel-indexing-service/prisma/schema.prisma:147-232&quot;]" relationKind="association" enforcement="declared relation"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="390.0032" y="773.4245759999999" /><mxPoint x="499.40160000000003" y="773.4245759999999" /></Array></mxGeometry></mxCell><mxCell id="E04-index-state-e1_label" value="attempt" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;ove