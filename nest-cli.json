{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/microservices-boilerplate/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": false,
          "introspectComments": true
        }
      }
    ],
    "webpack": true,
    "tsConfigPath": "apps/microservices-boilerplate/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/microservices-boilerplate",
  "projects": {
    "ai-service": {
      "type": "application",
      "root": "apps/ai-service",
      "entryFile": "main",
      "sourceRoot": "apps/ai-service/src",
      "compilerOptions": {
        "webpack": false,
        "tsConfigPath": "apps/ai-service/tsconfig.app.json"
      }
    },
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "content-service": {
      "type": "application",
      "root": "apps/content-service",
      "entryFile": "main",
      "sourceRoot": "apps/content-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/content-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "friend-service": {
      "type": "application",
      "root": "apps/friend-service",
      "entryFile": "main",
      "sourceRoot": "apps/friend-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/friend-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "conversation-service": {
      "type": "application",
      "root": "apps/conversation-service",
      "entryFile": "main",
      "sourceRoot": "apps/conversation-service/src",
