 height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Content findAccessibleSharedReelIds ignores userId; it filters conversationId plus ready/indexed Reel state, without independent current visibility/Friend/membership enforcement.&lt;br&gt;metadataShortcut := route.reelQuestionType == REEL_METADATA &amp;amp;&amp;amp; scope.length &amp;gt; 0.&lt;br&gt;chronologicalShortcut := plan.sourceOrder == ASC &amp;amp;&amp;amp; scope.length == 1 &amp;amp;&amp;amp; includeTranscript &amp;amp;&amp;amp; !includeVisual; later branches exclude earlier shortcuts.&lt;br&gt;Main view is the shared-Reel question path; recommendation action is an independent destination and is outside this focused retrieval scope.&lt;br&gt;Tool-call cap does not imply parallel execution: selected calls are awaited serially in the source." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="5938" width="2164" height="138" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="40-rag-memory" name="40 · Bounded AI memory and completed turns"><mxGraphModel page="0" pageWidth="1955" pageHeight="4889" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;40-rag-memory&quot;,&quot;title&quot;:&quot;40 \u00b7 Bounded AI memory and completed turns&quot;,&quot;subtitle&quot;:&quot;Bounded request memory first; saved assistant precedes independently handled completed-turn writes.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;conversation&quot;,&quot;label&quot;:&quot;Conversation Service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&