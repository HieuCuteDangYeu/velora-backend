12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="4739" width="1899" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="41-rag-answer" name="41 · RAG answer and streamed delivery"><mxGraphModel page="0" pageWidth="1690" pageHeight="6827" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;41-rag-answer&quot;,&quot;title&quot;:&quot;41 \u00b7 RAG answer and streamed delivery&quot;,&quot;subtitle&quot;:&quot;Bounded verifier and separate citation revisions; independent token events and durable final reply.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Mobile AI conversation&quot;,&quot;kind&quot;:&quot;client&quot;,&quot;evidence&quot;:[&quot;mobile:src/providers/SocketProvider.tsx:1371-1414&quot;]},{&quot;id&quot;:&quot;conversation&quot;,&quot;label&quot;:&quot;Conversation Service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/process-bot-reply.use-case.ts:32-118&quot;]},{&quot;id&quot;:&quot;cdb&quot;,&quot;label&quot;:&quot;Conversation message store&quot;,&quot;kind&quot;:&quot;store&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/process-bot-reply.use-case.ts:79-79&quot;]},{&quot;id&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;AI RAG workflow&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:475-495&quot;]},{&quot;id&quot;:&quot;provider&quot;,&quot;label&quot;:&quot;Structured / streaming LLM provider&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/stream-final-answer.use-case.ts:34-52&quot;]},{&quot;id&quot;:&quot;rmq&quot;,&quot;label&quot;:&quot;RabbitMQ token / memory channels&quot;,&quot;kind&quot;:&quot;external&quot;,&quo