  "cards": [
    {
      "dot": "cyan",
      "title": "Model-backed work",
      "items": [
        "Vision: Cloudflare @cf/meta/llama-4-scout-17b-16e-instruct for caption, OCR, and objects.",
        "Transcription: Groq whisper-large-v3-turbo with resumable per-segment checkpoints.",
        "Metadata + optional index-quality review: openai/gpt-oss-20b through the structured LLM service.",
        "Embeddings + adaptive boundary scoring: self-hosted TEI BAAI/bge-m3, 1024d, bge-m3-tei-v1."
      ]
    },
    {
      "dot": "violet",
      "title": "Required system architecture",
      "items": [
        "Reel Indexing Service owns LangGraph and calls AI Service over RabbitMQ request/reply.",
        "Artifact storage supplies transcription-audio and visual-frame manifests plus verified objects.",
        "PostgreSQL/Prisma stores domain checkpoints, LangGraph state, embedding cache, semantic rows, and pgvector.",
        "Content Service owns attempt claim, progress, and completion; semantic candidates stay inactive until final gates pass."
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability + activation safety",
      "items": [
        "LangGraph thread_id = reelId:indexAttemptId:indexVersion; checkpoint namespace is reel-index-v2.",
        "Embedding cache identity binds stable item, input hash, model identity, and index/chunk/summary versions.",
        "Persistence uses a per-reel PostgreSQL advisory transaction lock; commit rechecks current-attempt ownership and can rollback/discard stale candidates."
      ]
    }
  ]
}
