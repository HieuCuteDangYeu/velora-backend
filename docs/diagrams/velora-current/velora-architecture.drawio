uot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/api/media.api.ts:13-37&quot;,&quot;backend:apps/api-gateway/src/media/media.controller.ts:34-58&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;gateway&quot;,&quot;to&quot;:&quot;media&quot;,&quot;label&quot;:&quot;media.get_presigned_url (userId, fileType, purpose)&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/api-gateway/src/media/media.controller.ts:46-70&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;media&quot;,&quot;to&quot;:&quot;gateway&quot;,&quot;label&quot;:&quot;Presigned PUT URL for chat-images/{userId}/{uuid}.{ext}&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-service/src/application/use-cases/get-presigned-url.use-case.ts:52-76&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;r2&quot;,&quot;label&quot;:&quot;PUT the photo directly to storage&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/api/media.api.ts:39-46&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;conv&quot;,&quot;label&quot;:&quot;send_message (type image, media.fileKey, optional caption, clientMessageId)&quot;,&quot;sort&quot;:&quot;asynchSignal&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/infrastructure/gateways/chat.gateway.ts:298-322&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;the photo key belongs to the sender and is JPEG, PNG or WebP&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Only the sender's own upload may be read by the AI; the caption is the words, and the composer placeholder counts as no caption&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/policies/bot-turn-image.ts:22-40&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;the sender is inside both the turn budget and the tighter photo budget&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;conv&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;ai.stream_question (caption, photo key and type, answerMemory)&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/process-bot-reply.use-case.ts:53-77&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Input guardrail screens the caption first (39a); a bare photo asks for Reels like the picture&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/stream-chat.use-case.ts:14-38&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;At most 3 photos per turn; every key is checked against the requester before any download&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:52-76&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;r2&quot;,&quot;label&quot;:&quot;Read the photo by key (size limit 4 MiB by default)&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:61-85&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;r2&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;Photo bytes&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/services/r2-chat-image-storage.service.ts:14-38&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;vision&quot;,&quot;label&quot;:&quot;Analyse the image: caption, visible text, objects (Cloudflare first, Groq when its daily allocation is spent)&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:73-97&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;the provider describes the photo&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;vision&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;Description, text found in the photo, up to 12 objects&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:86-110&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Text inside a photo is attacker-controllable: the typed-input pattern check screens it and a hit drops the text but keeps the description&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:96-120&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;The description is appended to the question as data (never instructions); the router treats questions about the photo itself as OFF_TOPIC and \&quot;Reels like this\&quot; as discovery&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/query-router-agent.use-case.ts:113-137&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;The normal RAG workflow answers (39a to 41b)&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/stream-chat.use-case.ts:90-111&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;conv&quot;,&quot;label&quot;:&quot;Answer, citations, recommended Reels and a 240-character photo description&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/stream-chat.use-case.ts:16-40&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;The bot message keeps photoOfMessageId and photoDescription so memory can recall what the photo showed (43c)&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/process-bot-reply.use-case.ts:93-117&quot;]}]},{&quot;guard&quot;:&quot;the provider quota is spent&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;conv&quot;,&quot;label&quot;:&quot;AI_BUSY with retryAfterSeconds (60 s)&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/describe-chat-images.use-case.ts:81-105&quot;]}]},{&quot;guard&quot;:&quot;the photo cannot be read&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;conv&quot;,&quot;label&quot;:&quot;IMAGE_UNREADABLE: say so instead of answering without the photo&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/controller/ai.controller.ts:346-370&quot;]}]}]}]},{&quot;guard&quot;:&quot;the sender exceeded a turn or photo budget&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;conv&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;bot_reply_failed with RATE_LIMITED and retryAfterSeconds; the photo message stays stored&quot;,&quot;sort&quot;:&quot;asynchSignal&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/trigger-bot-reply.use-case.ts:64-88&quot;]}]}]}]},{&quot;guard&quot;:&quot;the key is not the sender's or the type is unsupported&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;The message is an ordinary photo message: no AI turn starts&quot;,&quot;evidence&quot;:[&quot;backend:apps/conversation-service/src/application/use-cases/trigger-bot-