l><mxCell id="s27" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1" sourceEvidence="[&quot;backend:scripts/ops/langfuse-rag-traces.cjs:81-86&quot;]" messageSort="synchCall" fromParticipant="operator" toParticipant="operator" order="14"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="3224" as="sourcePoint" /><mxPoint x="1190" y="3248" as="targetPoint" /><Array as="points"><mxPoint x="1224" y="3224" /><mxPoint x="1224" y="3248" /></Array></mxGeometry></mxCell><mxCell id="s27_label" value="14. Return validated traces for&lt;br&gt;diagnostic export" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;backend:scripts/ops/langfuse-rag-traces.cjs:81-86&quot;]"><mxGeometry x="1232" y="3171" width="235" height="48" as="geometry" /></mxCell><mxCell id="title" value="42 · Langfuse monitoring and diagnostic export" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1369" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Root creation, nested snapshot capture handling, and independent ops provenance validation." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1369" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Fail-open claim is limited to the snapshot-build/setRootOutput catch; it does not promise all SDK/tracing failures are harmless.&lt;br&gt;Langfuse returns raw observations. The ops reader validates/decode provenance and can reject incomplete or ambiguous records.&lt;br&gt;Rendering is parent-owned; fragment containment is recursive in this model, with no crossing XML coordinates supplied.&lt;br&gt;No retired RagTrace persistence is present in this focused workflow/ops path." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="3383" width="1369" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>