rvice/src/infrastructure/adapters/ai-service.adapter.ts:46-68&quot;]"><mxGeometry x="407" y="6381" width="505" height="28" as="geometry" /></mxCell><mxCell id="s54" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=open;endFill=0" sourceEvidence="[&quot;backend:apps/conversation-service/src/infrastructure/gateways/chat.gateway.ts:336-345&quot;]" messageSort="asynchSignal" fromParticipant="conversation" toParticipant="mobile" order="23"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="6520" as="sourcePoint" /><mxPoint x="130" y="6520" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s54_label" value="23. bot_reply_failed; no&lt;br&gt;assistant save or completed-turn&lt;br&gt;event" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/conversation-service/src/infrastructure/gateways/chat.gateway.ts:336-345&quot;]"><mxGeometry x="142" y="6447" width="240" height="68" as="geometry" /></mxCell><mxCell id="title" value="41 · RAG answer and streamed delivery" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1634" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Bounded verifier and separate citation revisions; independent token events and durable final reply." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1634" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;maxAnswerRevisions and maxCitationRevisions are independent config values (default 1, bounded 0..2); minConfidence defaults 0.65 and coverage threshold 1.&lt;br&gt;citationNeeded := REEL_VIDEO_QUESTION &amp;amp;&amp;amp; allowsGroundedGeneration &amp;amp;&amp;amp; nonempty answer &amp;amp;&amp;amp; nonempty citation candidates.&lt;br&gt;Verification failure/no-context can produce nonempty refusal or guarded rescue text that is streamed and saved; they do not automatically mean bot_reply_failed.&lt;br&gt;A failed answer-quality check can still route to citations at sufficient confidence after its permitted revision; the exact router guard is preserved.&lt;br&gt;Existing answer chunk size is 80 UTF-16 code units. Token send is not awaited and does not imply receipt before final RPC or persistence.&lt;br&gt;Last verifier route names the actual conditional-edge selection, captured before the failure handler can replace answer/verification state.&lt;br&gt;Token-consumer operand has no dependency requiring it to drain before the foreground RPC/save/final new_message path." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="6623" width="1634" height="174" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="42-observability-sequence" name="42 · Langfuse monitoring and diagnostic export"><mxGraphModel page="0" pageWidth="1425" pageHeight="3533" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;42-observability-sequence&quot;,&quot;title&quot;:&quot;42 \u00b7 Langfuse monitoring and diagnostic export&quot;,&quot;subtitle&quot;:&quot;Root creation, nested snapshot capture handling, and independent ops provenance validation.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;workflow&quot;,&quot;label&quot;:&quot;AI RAG workflow&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:157-175&quot;]},{&quot;id&quot;:&quot;tracing&quot;,&quot;label&quot;:&quot;Langfuse tracing adapter&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/services/langfuse-tracing.service.ts:65-108&quot;]},{&quot;id&quot;:&quot;sdk&quot;,&quot;label&quot;:&quot;OTEL SDK / Langfuse processor&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/services/langfuse-telemetry.ts:22-45&quot;]},{&quot;id&quot;:&quot;langfuse&quot;,&quot;label&quot;:&quot;Langfuse observations API&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;evidence&quot;:[&quot;backend:scripts/ops/langfuse-rag-traces.cjs:60-66&quot;]},{&quot;id&quot;:&quot;operator&quot;,&quot;label&quot;:&quot;Ops diagnostic reader/export&quot;,&quot;kind&quot;:&quot;client&quot;,&quot;evidence&quot;:[&quot;backend:scripts/ops/langfuse-rag-traces.cjs:20-86&quot;]}],&quot;steps&quot;:[{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;operation == workflow invocation&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;workflow&quot;,&quot;to&quot;:&quot;workflow&quot;,&quot;label&quot;:&quot;Allocate productionExecutionId = randomUUID()&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:157-160&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;tracing service exists &amp;&amp; LANGFUSE_ENABLED == true &amp;&amp; public/secret keys configured&quot;,&quot;steps&quot;:[{&quot;type&quot;: