alScene" domainRole="entity"><mxGeometry as="geometry" x="859.0" y="524.9880000000002" width="440" height="185" /></mxCell><mxCell id="ReelVisualScene_fields" value="rowId: String [PK]&lt;br&gt;id: String&lt;br&gt;parentId: String&lt;br&gt;indexAttemptId: String&lt;br&gt;isActive: Boolean" vertex="1" parent="ReelVisualScene" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeColor=none;fillColor=none;fontFamily=Arial;"><mxGeometry as="geometry" x="0" y="69" width="440" height="116" /></mxCell><mxCell id="title" value="14 · Semantic evidence entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontStyle=1;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="17" width="1399.032" height="45" /></mxCell><mxCell id="subtitle" value="ID-based hierarchy built and validated by indexing code; these links are not Prisma-declared foreign keys." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;align=left;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="65" width="1399.032" height="65" /></mxCell><mxCell id="notes" value="Solid entity links: declared PG FK / Mongo ORM. Dashed: logical IDs; multiplicity is not an integrity guarantee.&lt;br&gt;Chunk has one parent selected by strategy: section OR document. The two optional parent links are alternatives, not simultaneous parents.&lt;br&gt;Semantic tables use rowId PK and UNIQUE(id,indexAttemptId). Historical candidates can exist; retrieval serves accepted active rows.&lt;br&gt;Dashed-link multiplicities are intended or possible associations; a stored ID does not guarantee the target exists.&lt;br&gt;Migrations declare partial uniqueness for active rows: at most one active ReelDocument per Reel, and one active section/chunk/scene per stable id. Live migration application is not probed." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;fontColor=#687782;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="1474.9840000000002" width="1399.032" height="137" /></mxCell></root></mxGraphModel></diagram><diagram id="15-index-state" name="15 · Indexing attempt and reusable state"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1818" pageHeight="1355" shadow="0"><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="E04-index-state-e1" value="" edge="1" parent="1" source="AudioSegmentCheckpoint" target="IndexingAttempt" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#687782;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;entryX=0.1600000000000001;entryY=0.0;endArrow=none;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/reel-indexing-service/prisma/schema.prisma:147-232&quot;]" relationKind="declared association"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="390.0032" y="773.4245759999999" /><mxPoint x="499.40160000000003" y="773.4245759999999" /></Array></mxGeometry></mxCell><mxCell id="E04-index-state-e1_label" value="indexAttemptId; Cascade delete" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=0;fontFamily=Arial;"><mxGeometry as="geometry" x="506.40160000000003" y="791.5744319999999" width="228.6" height="32" /></mxCell><mxCell id="E04-index-state-e1_multiplicity0" value="0..*" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;fontFamily=Arial;"><mxGeometry as="geometry" x="402.0032" y="734.0247999999999" width="48" height="18" /></mxCell><mxCell id="E04-index-state-e1_multiplicity1" value="1" vertex="1" parent="1" style="text;ht