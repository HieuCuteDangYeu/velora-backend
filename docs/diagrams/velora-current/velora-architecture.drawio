ndArrow=open;endFill=0;dashed=1" sourceEvidence="[&quot;backend:apps/api-gateway/src/friends/friend.controller.ts:74-80&quot;]" messageSort="reply" fromParticipant="gateway" toParticipant="recipient" order="21"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="3181" as="sourcePoint" /><mxPoint x="395" y="3181" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s33_label" value="21. HTTP failed acceptance" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/api-gateway/src/friends/friend.controller.ts:74-80&quot;]"><mxGeometry x="407" y="3148" width="240" height="28" as="geometry" /></mxCell><mxCell id="title" value="23 · Send and accept friend requests" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1634" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="A sends to B; B independently selects an incoming request and accepts; no push/notification bridge." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1634" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Logical awaited RabbitMQ RPC; authenticate/route role guards are abstracted at entry.&lt;br&gt;Later acceptance is gated by B selecting the appropriate incoming identity; a reverse request_received result does not force B acceptance of an A-&amp;gt;B request.&lt;br&gt;Acceptance awaits ancillary work before replying; ordinary Conversation creation is omitted by scope.&lt;br&gt;Self, absent-target and blocked-send/accept failures terminate inside the focused refs." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="3356" width="1634" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="24-friendship-removal" name="24 · Reject, cancel or remove a friendship relationship"><mxGraphModel page="0" pageWidth="1160" pageHeight="4081" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;24-friendship-removal&quot;,&quot;title&quot;:&quot;24 \u00b7 Reject, cancel or remove a friendship relationship&quot;,&quot;subtitle&quot;:&quot;Independent reject/cancel/remove choices; actor/PENDING checks occur inside the attempted operation.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Velora-Mobile: authenticated actor&quot;,&quot;kind&quot;:&quot;client&quot;,&quot;evidence&quot;:[&quot;mobile:src/api/friend.api.ts:45-75&quot;]},{&quot;id&quot;:&quot;gateway&quot;,&quot;label&quot;:&quot;API Gateway&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/api-gateway/src/friends/friend.controller.ts:37-120&quot;]},{&quot;id&quot;:&quot;friend&quot;,&quot;label&quot;:&quot;Friend service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/friend-service/src/application/use-cases/send-friend-request.use-case.ts:24-89&quot;]},{&quot;id&quot;:&quot;db&quot;,&quot;label&quot;:&quot;Friend private database&quot;,&quot;kind&quot;:&quot;store&quot;,&quot;evidence&quot;:[&quot;backend:apps/friend-service/src/infrastructure/repositories/friend.repository.ts:51-219&quot;]}],&quot;steps&quot;:[{&quot;ty