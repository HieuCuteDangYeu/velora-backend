#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/home/quan/apps/microservices-boilerplate"
STATE_DIR="/home/quan/.local/state/velora"
STATE_FILE="$STATE_DIR/deployed-sha"
PREVIOUS_STATE_FILE="$STATE_DIR/previous-sha"
ENV_HASH_FILE="$STATE_DIR/env.sha256"
LOCK_FILE="$STATE_DIR/deploy.lock"
BLOCKED_DIR="$STATE_DIR/blocked"
DB_APPROVAL_DIR="$STATE_DIR/db-approvals"
DEPLOYMENT_AUDIT_DIR="$STATE_DIR/deployments"
STAGING_ROOT="$STATE_DIR/staging"
MIN_FREE_GB="${VELORA_MIN_FREE_GB:-20}"
MIN_AVAILABLE_RAM_MB="${VELORA_MIN_AVAILABLE_RAM_MB:-1024}"
WARN_AVAILABLE_RAM_MB="${VELORA_WARN_AVAILABLE_RAM_MB:-1536}"
RECEIPT_SCRIPT="/usr/local/bin/velora-report-deployed"
PULL_ATTEMPTS="${VELORA_PULL_ATTEMPTS:-3}"
HTTP_ATTEMPTS="${VELORA_HTTP_ATTEMPTS:-12}"
HTTP_RETRY_DELAY_SECONDS="${VELORA_HTTP_RETRY_DELAY_SECONDS:-5}"
RABBITMQ_AUTH_TIMEOUT_SECONDS="${VELORA_RABBITMQ_AUTH_TIMEOUT_SECONDS:-10}"
PUBLIC_SMOKE_TIMEOUT_SECONDS="${VELORA_PUBLIC_SMOKE_TIMEOUT_SECONDS:-10}"

APP_IMAGE_SERVICES=(
  api-gateway
  user-service
  friend-service
  auth-service
  media-service
  media-processing-service
  reel-indexing-service
  content-service
  payment-service
  mail-service
  conversation-service
  call-service
  monitoring-service
  notification-service
  ai-service
)

APP_SERVICES=(
  api-gateway
  user-service
  friend-service
  auth-service
  media-service
  media-processing-service
  media-processing-long-service
  reel-indexing-service
  reel-indexing-long-service
  content-service
  payment-service
  mail-service
  conversation-service
  call-service
  monitoring-service
  notification-service
  ai-service
)

PROTECTED_SERVICES=(
  rag-embedding
  rag-reranker
  rag-vision
  rag-eval
)

MANAGED_INFRA_SERVICES=(
  nginx
  prometheus
  grafana
)

BLOCKED_COMPOSE_SERVICES=(
  rabbitmq
  rag-embedding
  rag-reranker
  rag-vision
  rag-eval
)

UNMANAGED_DB_SERVICES=(
  user-service
  auth-service
  friend-service
  content-service
  payment-service
  notification-service
  conversation-service
)

SELF_MIGRATING_DB_SERVICES=(
  ai-service
  monitoring-service
  reel-indexing-service
)

RABBITMQ_QUEUE_MAP=(
  'auth-service:auth_queue'
  'payment-service:payment_queue'
  'ai-service:ai_queue'
  'mail-service:mail_queue'
  'conversation-service:conversation_queue'
  'call-service:call_queue'
  'friend-service:friend_queue'
  'monitoring-service:monitoring_queue'
  'media-service:media_queue'
  'content-service:content_queue'
  'user-service:user_queue'
)

DRY_RUN=false
FORCE=false
RETRY_FAILED=false
MANUAL_ROLLBACK=false
APPROVE_DB_SHA=""
TARGET_SHA=""
CURRENT_SHA=""
LAST_DEPLOYED_SHA=""
PREVIOUS_DEPLOYED_SHA=""
FROM_SHA=""
CHANGED_FILES=""
DB_RISK=false
ENV_DRIFT=false
STAGING_DIR=""
BASELINE_DIR=""
TARGET_COMPOSE_JSON=""
BASE_COMPOSE_JSON=""

PULL_SERVICES=()
RECONCILE_SERVICES=()
INFRA_RECONCILE_SERVICES=()

DEPLOY_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
DEPLOY_STARTED_EPOCH="$(date +%s)"

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

add_unique() {
  local candidate="$1"
  local -n target_array="$2"
  local item
  for item in "${target_array[@]:-}"; do
    [[ "$item" == "$candidate" ]] && return 0
  done
  target_array+=("$candidate")
}

safe_sha_prefix() {
  local sha="$1"
  printf '%s' "${sha:0:12}"
}

sha256_file() {
  local file="$1"
  sha256sum "$file" | awk '{print $1}'
}

cleanup_worktrees() {
  if [[ -n "${STAGING_DIR:-}" && -d "$STAGING_DIR" ]]; then
    git worktree remove --force "$STAGING_DIR" >/dev/null 2>&1 || rm -rf -- "$STAGING_DIR"
  fi
  if [[ -n "${BASELINE_DIR:-}" && -d "$BASELINE_DIR" ]]; then
    git worktree remove --force "$BASELINE_DIR" >/dev/null 2>&1 || rm -rf -- "$BASELINE_DIR"
  fi
  git worktree prune >/dev/null 2>&1 || true
}

on_err() {
  local exit_code=$?
  local line_no="${BASH_LINENO[0]:-unknown}"
  warn "deployment command failed at line $line_no (exit $exit_code)."
  exit "$exit_code"
}

trap cleanup_worktrees EXIT
trap on_err ERR

usage() {
  cat <<'EOF'
Usage: velora-deploy [options]

Options:
  --dry-run                 Build and validate a deployment plan without mutating production.
  --force                   Reconcile current config/release even when target SHA is unchanged.
  --retry-failed            Retry the currently promoted SHA even if it is blocked.
  --rollback                Roll back application containers to the previous healthy release.
  --approve-db-change SHA   Record operator approval that DB-impact changes for SHA were handled.
  -h, --help                Show this help.
EOF
}

while (($# > 0)); do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --force)
      FORCE=true
      shift
      ;;
    --retry-failed)
      RETRY_FAILED=true
      shift
      ;;
    --rollback)
      MANUAL_ROLLBACK=true
      shift
      ;;
    --approve-db-change)
      [[ $# -ge 2 ]] || fail '--approve-db-change requires a SHA'
      APPROVE_DB_SHA="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

for command_name in git docker jq curl awk sed grep sha256sum flock df free stat timeout date; do
  require_command "$command_name"
done

mkdir -p "$STATE_DIR" "$BLOCKED_DIR" "$DB_APPROVAL_DIR" "$DEPLOYMENT_AUDIT_DIR" "$STAGING_ROOT"
chmod 700 "$STATE_DIR" "$BLOCKED_DIR" "$DB_APPROVAL_DIR" "$DEPLOYMENT_AUDIT_DIR" "$STAGING_ROOT" 2>/dev/null || true

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log 'Another Velora deployment is already running; exiting.'
  exit 0
fi

cd "$APP_DIR"
[[ -d .git ]] || fail "$APP_DIR is not a Git repository"
[[ -f .env ]] || fail "$APP_DIR/.env is missing"

if [[ -n "$APPROVE_DB_SHA" ]]; then
  git rev-parse --verify "${APPROVE_DB_SHA}^{commit}" >/dev/null 2>&1 \
    || git fetch --no-tags origin "$APPROVE_DB_SHA" >/dev/null 2>&1 \
    || fail "cannot resolve DB approval SHA: $APPROVE_DB_SHA"
  APPROVE_DB_SHA="$(git rev-parse "$APPROVE_DB_SHA")"
  install -m 600 /dev/null "$DB_APPROVAL_DIR/$APPROVE_DB_SHA"
  log "Recorded DB-change approval for $APPROVE_DB_SHA"
  exit 0
fi

tracked_dirty="$(git status --porcelain --untracked-files=no)"
[[ -z "$tracked_dirty" ]] || fail 'tracked local changes exist in the production checkout; refusing deployment'

log '==> Fetching master and homelab-deploy...'
git fetch --no-tags origin master homelab-deploy

CURRENT_SHA="$(git rev-parse HEAD)"
TARGET_SHA="$(git rev-parse origin/homelab-deploy)"
LAST_DEPLOYED_SHA="$(cat "$STATE_FILE" 2>/dev/null || true)"
PREVIOUS_DEPLOYED_SHA="$(cat "$PREVIOUS_STATE_FILE" 2>/dev/null || true)"

if [[ -z "$LAST_DEPLOYED_SHA" ]]; then
  LAST_DEPLOYED_SHA="$CURRENT_SHA"
fi

if [[ "$MANUAL_ROLLBACK" == true ]]; then
  [[ -n "$PREVIOUS_DEPLOYED_SHA" ]] || fail 'no previous healthy release is recorded'
  TARGET_SHA="$PREVIOUS_DEPLOYED_SHA"
fi

if ! git merge-base --is-ancestor "$TARGET_SHA" origin/master; then
  fail "target $TARGET_SHA is not an ancestor of origin/master"
fi

if [[ "$MANUAL_ROLLBACK" != true && -n "$LAST_DEPLOYED_SHA" ]]; then
  if ! git merge-base --is-ancestor "$LAST_DEPLOYED_SHA" "$TARGET_SHA"; then
    fail "target $TARGET_SHA does not fast-forward from last successful release $LAST_DEPLOYED_SHA"
  fi
fi

blocked_file="$BLOCKED_DIR/$TARGET_SHA.json"
if [[ -f "$blocked_file" && "$RETRY_FAILED" != true && "$MANUAL_ROLLBACK" != true ]]; then
  warn "promoted release $TARGET_SHA is blocked after a previous release-specific failure; skipping"
  exit 0
fi

root_free_gb="$(df -Pk / | awk 'NR==2 {printf "%d", $4/1024/1024}')"
mem_available_mb="$(awk '/MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo)"

if [[ "$TARGET_SHA" != "$LAST_DEPLOYED_SHA" || "$FORCE" == true || "$MANUAL_ROLLBACK" == true ]]; then
  log "Root disk free : ${root_free_gb} GB"
  if (( root_free_gb < MIN_FREE_GB )); then
    warn "root disk has less than ${MIN_FREE_GB} GB free; pruning dangling images"
    docker image prune -f >/dev/null || true
    root_free_gb="$(df -Pk / | awk 'NR==2 {printf "%d", $4/1024/1024}')"
    (( root_free_gb >= MIN_FREE_GB )) || fail "root disk still has only ${root_free_gb} GB free"
  fi

  log "MemAvailable   : ${mem_available_mb} MB"
  if (( mem_available_mb < MIN_AVAILABLE_RAM_MB )); then
    fail "MemAvailable is ${mem_available_mb} MB, below deployment floor ${MIN_AVAILABLE_RAM_MB} MB"
  fi
  if (( mem_available_mb < WARN_AVAILABLE_RAM_MB )); then
    warn "MemAvailable is ${mem_available_mb} MB; deployment is allowed but close to the warning threshold"
  fi
fi

validate_rabbitmq_static() {
  log '==> Validating RabbitMQ configuration consistency...'
  node scripts/ops/validate-rabbitmq-config.cjs --env-file .env
}

rabbitmq_env_value() {
  local name="$1"
  docker compose exec -T rabbitmq sh -lc 'printf "%s" "${!1-}"' sh "$name"
}

validate_rabbitmq_live() {
  local username password vhost encoded_vhost endpoint http_code

  log '==> Validating live RabbitMQ application credentials and vhost permissions...'

  username="$(rabbitmq_env_value RABBITMQ_DEFAULT_USER)"
  password="$(rabbitmq_env_value RABBITMQ_DEFAULT_PASS)"
  vhost="$(rabbitmq_env_value RABBITMQ_DEFAULT_VHOST)"

  [[ -n "$username" && -n "$password" && -n "$vhost" ]] \
    || fail 'RabbitMQ container is missing one or more required application credential environment values'

  encoded_vhost="$(python3 - "$vhost" <<'PY'
import sys
from urllib.parse import quote
print(quote(sys.argv[1], safe=''))
PY
)"

  endpoint="http://127.0.0.1:15672/api/vhosts/$encoded_vhost"
  http_code="$(
    curl --silent --show-error \
      --max-time "$RABBITMQ_AUTH_TIMEOUT_SECONDS" \
      --user "$username:$password" \
      --output /dev/null \
      --write-out '%{http_code}' \
      "$endpoint" || true
  )"

  [[ "$http_code" == 200 ]] || fail "RabbitMQ live application authentication/vhost check failed (HTTP ${http_code:-000})"

  log 'RabbitMQ live authentication and vhost permissions are valid.'
}

validate_rabbitmq_static
validate_rabbitmq_live

wait_http_code() {
  local label="$1"
  local url="$2"
  shift 2
  local accepted=("$@")
  local attempt code expected

  for ((attempt=1; attempt<=HTTP_ATTEMPTS; attempt++)); do
    code="$(curl --silent --show-error --max-time 5 --output /dev/null --write-out '%{http_code}' "$url" || true)"
    for expected in "${accepted[@]}"; do
      if [[ "$code" == "$expected" ]]; then
        log "$label OK (HTTP $code)"
        return 0
      fi
    done
    (( attempt < HTTP_ATTEMPTS )) && sleep "$HTTP_RETRY_DELAY_SECONDS"
  done

  fail "$label failed after $HTTP_ATTEMPTS attempts (last HTTP ${code:-000})"
}

wait_container_http() {
  local service="$1"
  local port="$2"
  local label="$3"
  local attempt cid code

  for ((attempt=1; attempt<=HTTP_ATTEMPTS; attempt++)); do
    cid="$(docker compose ps -q "$service" | head -n1)"
    if [[ -n "$cid" ]]; then
      code="$(docker exec "$cid" node -e "const http=require('http'); const r=http.get({host:'127.0.0.1',port:${port},path:'/'},x=>{console.log(x.statusCode);x.resume()});r.on('error',()=>process.exit(2));r.setTimeout(3000,()=>{r.destroy();process.exit(3)})" 2>/dev/null || true)"
      if [[ "$code" =~ ^[234][0-9][0-9]$ ]]; then
        log "$label internal HTTP OK (HTTP $code)"
        return 0
      fi
    fi
    (( attempt < HTTP_ATTEMPTS )) && sleep "$HTTP_RETRY_DELAY_SECONDS"
  done

  fail "$label internal HTTP check failed"
}

verify_queue_consumer() {
  local service="$1"
  local queue="$2"
  local count attempt

  for ((attempt=1; attempt<=HTTP_ATTEMPTS; attempt++)); do
    count="$(docker compose exec -T rabbitmq rabbitmqctl list_queues name consumers --formatter json 2>/dev/null \
      | jq -r --arg q "$queue" '[.[] | select(.name == $q) | .consumers] | first // 0' 2>/dev/null || echo 0)"
    if [[ "$count" =~ ^[0-9]+$ ]] && (( count >= 1 )); then
      log "$service RabbitMQ readiness OK ($queue consumers=$count)"
      return 0
    fi
    (( attempt < HTTP_ATTEMPTS )) && sleep "$HTTP_RETRY_DELAY_SECONDS"
  done

  fail "$service RabbitMQ readiness failed ($queue consumers=${count:-0})"
}

verify_enabled_services_running() {
  local service ids id state enabled_services
  enabled_services="$(VELORA_IMAGE_TAG="${LAST_DEPLOYED_SHA:-latest}" docker compose config --services)"

  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    ids="$(docker compose ps -q "$service")"
    [[ -n "$ids" ]] || fail "$service has no running Compose container"
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      state="$(docker inspect -f '{{.State.Status}}' "$id")"
      [[ "$state" == running ]] || fail "$service container $id is $state"
    done <<< "$ids"
  done <<< "$enabled_services"

  local gateway_count
  gateway_count="$(docker compose ps -q api-gateway | sed '/^$/d' | wc -l | tr -d ' ')"
  [[ "$gateway_count" == 2 ]] || fail "api-gateway expected exactly 2 running replicas, found $gateway_count"

  log 'All enabled Docker Compose services are running.'
}

wait_docker_health() {
  local service="$1"
  local attempt cid health

  for ((attempt=1; attempt<=HTTP_ATTEMPTS; attempt++)); do
    cid="$(docker compose ps -q "$service" | head -n1)"
    if [[ -n "$cid" ]]; then
      health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
      case "$health" in
        healthy)
          log "$service Docker health is healthy."
          return 0
          ;;
        none)
          return 0
          ;;
      esac
    fi
    (( attempt < HTTP_ATTEMPTS )) && sleep "$HTTP_RETRY_DELAY_SECONDS"
  done

  fail "$service Docker health did not become healthy"
}

verify_health() {
  log '==> Verifying deployment health...'

  verify_enabled_services_running
  wait_docker_health rabbitmq
  wait_docker_health rag-embedding
  wait_docker_health rag-reranker
  wait_docker_health monitoring-service

  validate_rabbitmq_live

  local mapping service queue
  for mapping in "${RABBITMQ_QUEUE_MAP[@]}"; do
    service="${mapping%%:*}"
    queue="${mapping#*:}"
    verify_queue_consumer "$service" "$queue"
  done

  wait_http_code 'API Gateway via Nginx' 'http://127.0.0.1/' 200 404
  wait_http_code 'Conversation Socket.IO' 'http://127.0.0.1/conversation/socket.io/?EIO=4&transport=polling' 200
  wait_http_code 'Call Socket.IO' 'http://127.0.0.1/call/socket.io/?EIO=4&transport=polling' 200
  wait_container_http payment-service 3006 payment-service
  wait_container_http notification-service 3015 notification-service

  if [[ -x scripts/ops/check-monitoring-stack.sh ]]; then
    log '==> Running monitoring stack smoke check...'
    scripts/ops/check-monitoring-stack.sh
  fi

  public_url="${BACKEND_URL:-}"
  if [[ -z "$public_url" ]]; then
    public_url="$(grep -E '^BACKEND_URL=' .env | tail -n1 | cut -d= -f2- || true)"
  fi
  if [[ -n "$public_url" ]]; then
    public_code="$(curl --silent --show-error --max-time "$PUBLIC_SMOKE_TIMEOUT_SECONDS" --output /dev/null --write-out '%{http_code}' "$public_url" || true)"
    if [[ "$public_code" =~ ^[234][0-9][0-9]$ ]]; then
      log "Public endpoint reachable (HTTP $public_code)."
    else
      warn "public endpoint smoke failed (HTTP ${public_code:-000}) while internal health passed; deployment remains successful"
    fi
  fi
}

if [[ "$TARGET_SHA" == "$LAST_DEPLOYED_SHA" && "$FORCE" != true && "$MANUAL_ROLLBACK" != true ]]; then
  log "Already successfully deployed: $TARGET_SHA"
  verify_health

  current_env_hash="$(sha256_file .env)"
  if [[ ! -f "$ENV_HASH_FILE" ]]; then
    printf '%s\n' "$current_env_hash" >"$ENV_HASH_FILE"
    chmod 600 "$ENV_HASH_FILE" || true
    log 'Initialized .env hash baseline for the healthy release.'
  elif [[ "$(cat "$ENV_HASH_FILE")" != "$current_env_hash" ]]; then
    warn '.env drift detected; normal timer will not restart production automatically. Use --force after reviewing the config change.'
  fi

  if [[ -x "$RECEIPT_SCRIPT" ]]; then
    "$RECEIPT_SCRIPT" "$TARGET_SHA" || warn 'failed to report healthy deployment receipt'
  fi
  exit 0
fi

FROM_SHA="$LAST_DEPLOYED_SHA"
if [[ -z "$FROM_SHA" || ! "$FROM_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  FROM_SHA="$CURRENT_SHA"
fi

make_worktree() {
  local sha="$1"
  local label="$2"
  local dir="$STAGING_ROOT/${label}-${sha:0:12}-$$"

  rm -rf -- "$dir"
  git worktree add --detach "$dir" "$sha" >/dev/null
  ln -s "$APP_DIR/.env" "$dir/.env"
  printf '%s' "$dir"
}

render_compose_json() {
  local dir="$1"
  local tag="$2"
  (
    cd "$dir"
    VELORA_IMAGE_TAG="$tag" docker compose config --no-path-resolution --format json
  )
}

normalize_compose_json() {
  local input_json="$1"
  local output_json="$2"
  local services_json
  services_json="$(printf '%s\n' "${APP_IMAGE_SERVICES[@]}" | jq -R . | jq -cs .)"

  jq --argjson apps "$services_json" '
    .services |= with_entries(
      .value |= del(.build)
      | if (.key as $k | $apps | index($k)) then
          .value.image = "__VELORA_APP_IMAGE__"
        else . end
    )
  ' "$input_json" >"$output_json"
}

validate_target_files() {
  local nginx_image prometheus_image

  log "==> Creating staging worktree for target $(safe_sha_prefix "$TARGET_SHA")..."
  STAGING_DIR="$(make_worktree "$TARGET_SHA" target)"

  log '==> Validating target Docker Compose...'
  (
    cd "$STAGING_DIR"
    VELORA_IMAGE_TAG="$TARGET_SHA" docker compose config --quiet
  )

  TARGET_COMPOSE_JSON="$STAGING_DIR/.velora-compose-target.json"
  render_compose_json "$STAGING_DIR" "__COMPARE__" >"$TARGET_COMPOSE_JSON"

  nginx_image="$(jq -r '.services.nginx.image // empty' "$TARGET_COMPOSE_JSON")"
  prometheus_image="$(jq -r '.services.prometheus.image // empty' "$TARGET_COMPOSE_JSON")"

  if [[ -f "$STAGING_DIR/infra/nginx/nginx.conf" && -n "$nginx_image" ]]; then
    log "==> Validating target Nginx configuration with $nginx_image..."
    docker run --rm \
      -v "$STAGING_DIR/infra/nginx/nginx.conf:/etc/nginx/nginx.conf:ro" \
      "$nginx_image" nginx -t >/dev/null
  fi

  if [[ -f "$STAGING_DIR/infra/monitoring/prometheus/prometheus.yml" && -n "$prometheus_image" ]]; then
    log "==> Validating target Prometheus configuration with $prometheus_image..."
    docker run --rm \
      --user 0:0 \
      --entrypoint /bin/promtool \
      -v "$STAGING_DIR/infra/monitoring/prometheus:/etc/prometheus:ro" \
      "$prometheus_image" \
      check config /etc/prometheus/prometheus.yml >/dev/null
  fi

  if [[ -d "$STAGING_DIR/infra/monitoring/grafana" ]]; then
    log '==> Validating target Grafana JSON files...'
    while IFS= read -r -d '' json_file; do
      jq -e . "$json_file" >/dev/null
    done < <(find "$STAGING_DIR/infra/monitoring/grafana" -type f -name '*.json' -print0)
  fi
}

add_app_and_worker_companions() {
  local service="$1"
  add_unique "$service" RECONCILE_SERVICES

  case "$service" in
    media-processing-service)
      add_unique media-processing-long-service RECONCILE_SERVICES
      ;;
    reel-indexing-service)
      add_unique reel-indexing-long-service RECONCILE_SERVICES
      ;;
  esac
}

add_all_application_services() {
  local service
  for service in "${APP_IMAGE_SERVICES[@]}"; do
    add_unique "$service" PULL_SERVICES
    add_app_and_worker_companions "$service"
  done
}

mark_db_risk_if_needed() {
  local file="$1"
  local service

  for service in "${UNMANAGED_DB_SERVICES[@]}"; do
    case "$file" in
      "apps/$service/prisma/schema.prisma"|"apps/$service/prisma/migrations/"*)
        DB_RISK=true
        if [[ ! -f "$DB_APPROVAL_DIR/$TARGET_SHA" ]]; then
          fail "database-impact change detected for $service; automatic deployment is paused until cloud DB work is confirmed with --approve-db-change $TARGET_SHA"
        fi
        ;;
    esac
  done

  for service in "${SELF_MIGRATING_DB_SERVICES[@]}"; do
    case "$file" in
      "apps/$service/prisma/schema.prisma"|"apps/$service/prisma/migrations/"*)
        DB_RISK=true
        ;;
    esac
  done
}

plan_from_compose_diff() {
  local base_normal target_normal service base_image target_image app_image_model_changed=false

  [[ -n "$FROM_SHA" ]] || return 0

  BASELINE_DIR="$(make_worktree "$FROM_SHA" baseline)"
  BASE_COMPOSE_JSON="$BASELINE_DIR/.velora-compose-base.json"
  render_compose_json "$BASELINE_DIR" "__BASE_COMPARE__" >"$BASE_COMPOSE_JSON"

  # Detect the one-time migration from mutable :latest application references to
  # ${VELORA_IMAGE_TAG:-latest}. After that transition, normalized Compose models
  # ignore application image tags so ordinary release SHAs do not look like config changes.
  for service in "${APP_IMAGE_SERVICES[@]}"; do
    base_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$BASE_COMPOSE_JSON")"
    target_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$TARGET_COMPOSE_JSON")"
    if [[ "$base_image" != "$target_image" ]]; then
      app_image_model_changed=true
      break
    fi
  done

  if [[ "$app_image_model_changed" == true ]]; then
    log 'Application image model changed; reconciling all application services onto immutable SHA tags.'
    add_all_application_services
  fi

  base_normal="$BASELINE_DIR/.velora-compose-base-normal.json"
  target_normal="$STAGING_DIR/.velora-compose-target-normal.json"
  normalize_compose_json "$BASE_COMPOSE_JSON" "$base_normal"
  normalize_compose_json "$TARGET_COMPOSE_JSON" "$target_normal"

  if ! jq -n -e --slurpfile a "$base_normal" --slurpfile b "$target_normal" '($a[0].networks == $b[0].networks) and ($a[0].volumes == $b[0].volumes)' >/dev/null; then
    fail 'top-level Compose networks/volumes changed; automatic deployment is intentionally blocked'
  fi

  while IFS= read -r service; do
    [[ -n "$service" ]] || continue

    if jq -e --arg service "$service" '.services[$service] != null' "$base_normal" >/dev/null \
      && ! jq -e --arg service "$service" '.services[$service] != null' "$target_normal" >/dev/null; then
      fail "Compose service '$service' was removed; automatic service removal is intentionally blocked"
    fi

    if contains "$service" "${BLOCKED_COMPOSE_SERVICES[@]}"; then
      fail "Compose configuration changed for protected/worker service '$service'; manual review is required"
    fi

    if contains "$service" "${APP_SERVICES[@]}"; then
      add_app_and_worker_companions "$service"
      continue
    fi

    if contains "$service" "${MANAGED_INFRA_SERVICES[@]}"; then
      add_unique "$service" INFRA_RECONCILE_SERVICES
      continue
    fi

    fail "Compose configuration changed for unmanaged service '$service'; manual review is required"
  done < <(
    jq -n -r --slurpfile a "$base_normal" --slurpfile b "$target_normal" '
      (($a[0].services // {}) + ($b[0].services // {}))
      | keys[] as $k
      | select(($a[0].services[$k] // null) != ($b[0].services[$k] // null))
      | $k
    '
  )
}

plan_from_changed_files() {
  local file service

  if [[ "$CHANGED_FILES" == "__INITIAL_RELEASE__" ]]; then
    add_all_application_services
    # Initial CD bootstrap deliberately does not auto-start protected workloads or RabbitMQ.
    add_unique nginx INFRA_RECONCILE_SERVICES
    add_unique prometheus INFRA_RECONCILE_SERVICES
    add_unique grafana INFRA_RECONCILE_SERVICES
    return
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    mark_db_risk_if_needed "$file"

    case "$file" in
      apps/*)
        service="${file#apps/}"
        service="${service%%/*}"
        if contains "$service" "${APP_IMAGE_SERVICES[@]}"; then
          add_unique "$service" PULL_SERVICES
          add_app_and_worker_companions "$service"
        fi
        ;;
      libs/*|package.json|pnpm-lock.yaml|pnpm-workspace.yaml|nest-cli.json|tsconfig.json|tsconfig.build.json|.npmrc|.dockerignore|Dockerfile|Dockerfile.*|docker/*|infra/docker/*)
        add_all_application_services
        ;;
      infra/nginx/*)
        add_unique nginx INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/prometheus/*)
        add_unique prometheus INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/grafana/*)
        add_unique grafana INFRA_RECONCILE_SERVICES
        ;;
      docker-compose.yml|docker-compose.yaml|docker-compose.*.yml|docker-compose.*.yaml|compose.yml|compose.yaml)
        # Exact per-service Compose changes are classified separately.
        ;;
      scripts/deploy/*|.github/*|docs/*|eval/rag/*|README.md|QWEN.md|CLAUDE.md|LICENSE*|*.md|.gitignore|.prettierrc|eslint.config.mjs|jest.config.cjs|.vscode/*)
        ;;
      scripts/*)
        add_all_application_services
        ;;
      *)
        # Unknown runtime/build inputs are conservative at the application layer.
        add_all_application_services
        ;;
    esac
  done <<< "$CHANGED_FILES"
}

if [[ -n "$FROM_SHA" && "$FROM_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  CHANGED_FILES="$(git diff --name-only "$FROM_SHA" "$TARGET_SHA")"
else
  CHANGED_FILES='__INITIAL_RELEASE__'
fi

current_env_hash="$(sha256_file .env)"
if [[ -f "$ENV_HASH_FILE" && "$(cat "$ENV_HASH_FILE")" != "$current_env_hash" ]]; then
  ENV_DRIFT=true
  if [[ "$FORCE" != true ]]; then
    fail '.env drift detected; review configuration and run --force to reconcile intentionally'
  fi
fi

validate_target_files
plan_from_changed_files
plan_from_compose_diff

if [[ "$MANUAL_ROLLBACK" == true ]]; then
  DB_RISK=false
  add_all_application_services
fi

print_plan() {
  local item
  printf '\n======================================\n'
  printf 'Velora deployment plan\n'
  printf 'From SHA : %s\n' "$FROM_SHA"
  printf 'To SHA   : %s\n' "$TARGET_SHA"
  printf 'DB risk  : %s\n' "$DB_RISK"
  printf 'Env drift: %s\n' "$([[ "$ENV_DRIFT" == true ]] && echo yes || echo no)"

  printf '\nApplication image pulls:\n'
  if (( ${#PULL_SERVICES[@]} == 0 )); then
    printf '  (none)\n'
  else
    for item in "${PULL_SERVICES[@]}"; do printf '  %s\n' "$item"; done
  fi

  printf '\nCompose services to reconcile:\n'
  if (( ${#RECONCILE_SERVICES[@]} == 0 )); then
    printf '  (none)\n'
  else
    for item in "${RECONCILE_SERVICES[@]}"; do printf '  %s\n' "$item"; done
  fi

  printf '\nManaged infrastructure:\n'
  if (( ${#INFRA_RECONCILE_SERVICES[@]} == 0 )); then
    printf '  (none)\n'
  else
    for item in "${INFRA_RECONCILE_SERVICES[@]}"; do printf '  %s\n' "$item"; done
  fi

  printf '\nProtected workloads preserved:\n'
  printf '  %s\n' "${PROTECTED_SERVICES[@]}"
  printf '======================================\n\n'
}

print_plan

if [[ "$DRY_RUN" == true ]]; then
  log 'Dry run complete. Production was not mutated.'
  exit 0
fi

prepull_target_images() {
  local service image attempt
  (( ${#PULL_SERVICES[@]} > 0 )) || return 0

  log '==> Pre-pulling immutable application images before production mutation...'
  for service in "${PULL_SERVICES[@]}"; do
    image="$((cd "$STAGING_DIR" && VELORA_IMAGE_TAG="$TARGET_SHA" docker compose config --format json) \
        | jq -r --arg service "$service" '.services[$service].image // empty')"
    [[ -n "$image" ]] || fail "target Compose has no image for $service"
    [[ "$image" == *":$TARGET_SHA" ]] || fail "target image for $service is not immutable SHA-tagged: $image"

    for ((attempt=1; attempt<=PULL_ATTEMPTS; attempt++)); do
      log "Pulling $image (attempt $attempt/$PULL_ATTEMPTS)..."
      if docker pull "$image"; then
        break
      fi
      if (( attempt == PULL_ATTEMPTS )); then
        fail "failed to pull $image after $PULL_ATTEMPTS attempts"
      fi
      sleep $((attempt * 5))
    done
  done
}

prepull_managed_infra() {
  local service image base_image attempt existing_container
  (( ${#INFRA_RECONCILE_SERVICES[@]} > 0 )) || return 0

  log '==> Pre-pulling explicitly changed infrastructure images...'
  for service in "${INFRA_RECONCILE_SERVICES[@]}"; do
    image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$TARGET_COMPOSE_JSON")"
    [[ -n "$image" ]] || continue

    base_image=""
    if [[ -n "$BASE_COMPOSE_JSON" && -f "$BASE_COMPOSE_JSON" ]]; then
      base_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$BASE_COMPOSE_JSON")"
    fi

    # A config-only change must not refresh a mutable :latest/alpine tag from a
    # registry. Reuse the already-present image when the Compose image reference
    # itself did not change.
    if [[ -n "$base_image" && "$image" == "$base_image" ]]; then
      log "$service image reference unchanged ($image); skipping registry pull."
      continue
    fi

    if [[ -z "$base_image" ]]; then
      existing_container="$(docker compose ps -aq "$service" | head -n 1)"
      if [[ -n "$existing_container" ]]; then
        log "$service has an existing container and no baseline release state; skipping automatic infra image refresh."
        continue
      fi
    fi

    for ((attempt=1; attempt<=PULL_ATTEMPTS; attempt++)); do
      log "Pulling infrastructure image $image (attempt $attempt/$PULL_ATTEMPTS)..."
      if docker pull "$image"; then
        break
      fi
      if (( attempt == PULL_ATTEMPTS )); then
        fail "failed to pull infrastructure image $image after $PULL_ATTEMPTS attempts"
      fi
      sleep $((attempt * 5))
    done
  done
}

snapshot_current_images() {
  local snapshot_file="$1"
  shift
  local service cid image_id

  : >"$snapshot_file"
  for service in "$@"; do
    while IFS= read -r cid; do
      [[ -n "$cid" ]] || continue
      image_id="$(docker inspect -f '{{.Image}}' "$cid")"
      printf '%s\t%s\n' "$service" "$image_id" >>"$snapshot_file"
    done < <(docker compose ps -q "$service")
  done
}

restore_snapshot_images() {
  local snapshot_file="$1"
  local service image_id
  local -A service_image=()

  while IFS=$'\t' read -r service image_id; do
    [[ -n "$service" && -n "$image_id" ]] || continue
    if [[ -z "${service_image[$service]:-}" ]]; then
      service_image[$service]="$image_id"
    fi
  done <"$snapshot_file"

  for service in "${!service_image[@]}"; do
    docker image tag "${service_image[$service]}" "velora-rollback/$service:restore"
  done

  # Compose does not provide an image override per service, so restore the prior
  # checkout and let its image references resolve to the previously running image.
  git checkout --detach "$FROM_SHA"
  git reset --hard "$FROM_SHA"

  for service in "${!service_image[@]}"; do
    old_ref="$(VELORA_IMAGE_TAG="$FROM_SHA" docker compose config --format json | jq -r --arg service "$service" '.services[$service].image // empty')"
    [[ -n "$old_ref" ]] || continue
    docker image tag "${service_image[$service]}" "$old_ref"
  done

  VELORA_IMAGE_TAG="$FROM_SHA" docker compose up -d --no-deps --scale api-gateway=2 "${!service_image[@]}"
}

write_audit() {
  local status="$1"
  local message="${2:-}"
  local finished_at finished_epoch duration file
  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  finished_epoch="$(date +%s)"
  duration=$((finished_epoch - DEPLOY_STARTED_EPOCH))
  file="$DEPLOYMENT_AUDIT_DIR/${DEPLOY_STARTED_AT//[:]/-}-${TARGET_SHA:0:12}.json"

  jq -n \
    --arg started_at "$DEPLOY_STARTED_AT" \
    --arg finished_at "$finished_at" \
    --arg status "$status" \
    --arg message "$message" \
    --arg from_sha "$FROM_SHA" \
    --arg to_sha "$TARGET_SHA" \
    --arg changed_files "$CHANGED_FILES" \
    --argjson db_risk "$DB_RISK" \
    --argjson env_drift "$ENV_DRIFT" \
    --argjson duration_seconds "$duration" \
    --argjson mem_available_mb "$(awk '/MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo)" \
    --argjson root_free_gb "$(df -Pk / | awk 'NR==2 {printf "%d", $4/1024/1024}')" \
    --argjson services "$(printf '%s\n' "${RECONCILE_SERVICES[@]:-}" | sed '/^$/d' | jq -R . | jq -cs .)" \
    --argjson infra "$(printf '%s\n' "${INFRA_RECONCILE_SERVICES[@]:-}" | sed '/^$/d' | jq -R . | jq -cs .)" \
    '{started_at:$started_at,finished_at:$finished_at,status:$status,message:$message,from_sha:$from_sha,to_sha:$to_sha,db_risk:$db_risk,env_drift:$env_drift,duration_seconds:$duration_seconds,mem_available_mb:$mem_available_mb,root_free_gb:$root_free_gb,changed_files:($changed_files|split("\n")|map(select(length>0))),services:$services,infra:$infra}' \
    >"$file"
  chmod 600 "$file" || true
}

mark_release_blocked() {
  local reason="$1"
  jq -n \
    --arg sha "$TARGET_SHA" \
    --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg reason "$reason" \
    '{sha:$sha,time:$time,reason:$reason}' \
    >"$BLOCKED_DIR/$TARGET_SHA.json"
  chmod 600 "$BLOCKED_DIR/$TARGET_SHA.json" || true
}

prepull_target_images
prepull_managed_infra

snapshot_file="$STATE_DIR/pre-deploy-images-$TARGET_SHA.tsv"
snapshot_current_images "$snapshot_file" "${RECONCILE_SERVICES[@]}"
chmod 600 "$snapshot_file" || true

log "==> Switching production checkout to $TARGET_SHA..."
git checkout --detach "$TARGET_SHA"
git reset --hard "$TARGET_SHA"

if (( ${#RECONCILE_SERVICES[@]} > 0 )); then
  log "==> Reconciling application services with immutable tag $(safe_sha_prefix "$TARGET_SHA")..."
  if ! VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --no-deps --scale api-gateway=2 "${RECONCILE_SERVICES[@]}"; then
    if [[ "$DB_RISK" == true ]]; then
      mark_release_blocked 'application reconcile failed after a DB-impact release; automatic rollback suppressed'
      write_audit failed 'application reconcile failed; DB-risk rollback suppressed'
      fail 'application reconcile failed after DB-impact change; release blocked for manual intervention'
    fi

    warn 'application reconcile failed; restoring previous application images'
    restore_snapshot_images "$snapshot_file"
    verify_health || true
    mark_release_blocked 'application reconcile failed and application rollback was attempted'
    write_audit rolled_back 'application reconcile failed; previous application images restored'
    fail 'application deployment failed and was rolled back'
  fi
fi

for infra_service in "${INFRA_RECONCILE_SERVICES[@]}"; do
  case "$infra_service" in
    nginx)
      log '==> Reconciling Nginx...'
      VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --no-deps --force-recreate nginx
      ;;
    prometheus)
      log '==> Recreating Prometheus after validated configuration change...'
      VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --no-deps --force-recreate prometheus
      for attempt in $(seq 1 "$HTTP_ATTEMPTS"); do
        if curl --fail --silent --show-error --max-time 5 http://127.0.0.1:9090/-/ready >/dev/null 2>&1; then
          break
        fi
        if (( attempt == HTTP_ATTEMPTS )); then
          fail 'Prometheus did not become ready after recreation'
        fi
        sleep "$HTTP_RETRY_DELAY_SECONDS"
      done
      ;;
    grafana)
      log '==> Reconciling Grafana...'
      VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --no-deps --force-recreate grafana
      ;;
  esac
done

if ! verify_health; then
  if [[ "$DB_RISK" == true ]]; then
    mark_release_blocked 'post-deploy health failed after DB-impact release; automatic rollback suppressed'
    write_audit failed 'post-deploy health failed; DB-risk rollback suppressed'
    fail 'health verification failed after DB-impact change; release blocked for manual intervention'
  fi

  warn 'post-deploy health failed; rolling back application containers'
  restore_snapshot_images "$snapshot_file"
  if ! verify_health; then
    mark_release_blocked 'target health failed and rollback health verification also failed'
    write_audit rollback_failed 'target and rollback health verification failed'
    fail 'target health failed and rollback did not restore a healthy state'
  fi

  mark_release_blocked 'target health failed; previous application release restored successfully'
  write_audit rolled_back 'target health failed; previous application release restored successfully'
  fail 'target release failed health verification and was rolled back'
fi

if [[ -n "$LAST_DEPLOYED_SHA" && "$LAST_DEPLOYED_SHA" != "$TARGET_SHA" ]]; then
  printf '%s\n' "$LAST_DEPLOYED_SHA" >"$PREVIOUS_STATE_FILE"
fi
printf '%s\n' "$TARGET_SHA" >"$STATE_FILE"
printf '%s\n' "$current_env_hash" >"$ENV_HASH_FILE"
chmod 600 "$STATE_FILE" "$PREVIOUS_STATE_FILE" "$ENV_HASH_FILE" 2>/dev/null || true
rm -f -- "$BLOCKED_DIR/$TARGET_SHA.json"

write_audit success 'deployment healthy'

if [[ -x "$RECEIPT_SCRIPT" ]]; then
  "$RECEIPT_SCRIPT" "$TARGET_SHA" || warn 'failed to report healthy deployment receipt; deployment remains successful'
fi

cleanup_old_release_images() {
  local keep_current="$TARGET_SHA"
  local keep_previous="$(cat "$PREVIOUS_STATE_FILE" 2>/dev/null || true)"
  local image_repo image_id tag sha

  log '==> Removing stale unused Velora application SHA tags...'
  for image_repo in "${APP_IMAGE_SERVICES[@]}"; do
    while IFS= read -r tag; do
      [[ "$tag" =~ :([0-9a-f]{40})$ ]] || continue
      sha="${BASH_REMATCH[1]}"
      [[ "$sha" == "$keep_current" || "$sha" == "$keep_previous" ]] && continue
      docker image rm "$tag" >/dev/null 2>&1 || true
    done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -E "/${image_repo}:[0-9a-f]{40}$" || true)
  done

  log '==> Pruning dangling Docker images...'
  docker image prune -f >/dev/null || warn 'failed to prune dangling images'
}

cleanup_old_release_images

final_mem_mb="$(awk '/MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo)"
final_disk_gb="$(df -Pk / | awk 'NR==2 {printf "%d", $4/1024/1024}')"

printf '======================================\n'
printf 'Deployment successful\n'
printf 'SHA              : %s\n' "$TARGET_SHA"
printf 'MemAvailable     : %s MB\n' "$final_mem_mb"
printf 'Root disk free   : %s GB\n' "$final_disk_gb"
printf 'API Gateway      : 2 replicas\n'
printf '======================================\n'
