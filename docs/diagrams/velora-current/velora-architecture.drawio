s independently; configured flushAt=20 / interval=5; sampling default=1; no workflow export-drain wait&quot;,&quot;participants&quot;:[&quot;sdk&quot;,&quot;langfuse&quot;],&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/services/langfuse-telemetry.ts:5-45&quot;]}]},{&quot;guard&quot;:&quot;else&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Execute same workflow without root; no snapshot builder when root absent; existing telemetry still publishes&quot;,&quot;participants&quot;:[&quot;workflow&quot;],&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:175-175&quot;,&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:257-282&quot;,&quot;backend:apps/ai-service/src/infrastructure/services/langfuse-tracing.service.ts:75-75&quot;]}]}],&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:162-175&quot;,&quot;backend:apps/ai-service/src/infrastructure/services/langfuse-telemetry.ts:7-12&quot;]}]},{&quot;guard&quot;:&quot;operation == independent operator export&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Operator client requires configured public/secret keys and explicit base URL&quot;,&quot;participants&quot;:[&quot;operator&quot;,&quot;langfuse&quot;],&quot;evidence&quot;:[&quot;backend:scripts/ops/langfuse-rag-traces.cjs:3-17&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;loop&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;first page or next cursor exists (reject repeated cursor)&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;operator&quot;,&quot;to&quot;:&quot;langfuse&quot;,&quot;label&quot;:&quot;observations.getMany(name=rag.workflow, fields=basic,time,io, limit=100, filters, cursor)&quot;,&quot;sort&quot;:&quot;synchCall&quot