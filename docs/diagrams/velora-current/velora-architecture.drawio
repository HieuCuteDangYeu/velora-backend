ndexing-service/src/application/use-cases/build-hierarchical-index.use-case.ts:41-61&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;Long videos: each transcript segment goes to exactly one section (the last section that starts at or before it) and chunk times are fitted inside that section, so overlapping section windows can no longer index a segment twice or fail validation&quot;,&quot;evidence&quot;:[&quot;backend:apps/reel-indexing-service/src/application/use-cases/build-long-evidence-chunks.use-case.ts:16-56&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;loop&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;up to 3 token-gate attempts while oversized drafts remain (batches of 100)&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;worker&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;Count document tokens (ai.count_document_tokens)&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/reel-indexing-service/src/application/use-cases/build-hierarchical-index.use-case.ts:257-257&quot;,&quot;backend:apps/reel-indexing-service/src/infrastructure/adapters/ai-service.adapter.ts:123-131&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;worker&quot;,&quot;label&quot;:&quot;Return exact token counts&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/reel-indexing-service/src/infrastructure/adapters/ai-service.adapter.ts:123-131&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;worker&quot;,&quot;to&quot;:&quot;ckpt&quot;,&quot;label&quot;:&quot;Persist token-validated or re-versioned drafts&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/reel-indexing-service/src/infrastructure/workflows/reel-index-langgraph.workflow.ts:807-818&quot;]}]}]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;worker&quot;,