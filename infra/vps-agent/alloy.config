// Log shipper for an additional VPS. Same pipeline as the homelab collector in
// infra/monitoring/alloy/config.alloy, with two differences: every line is
// tagged with the host id, and it pushes to Loki, which runs on this VPS (infra/loki-node), over the Tailscale address.

logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "vps" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "vps" {
  targets = discovery.docker.vps.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = ".+"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "vps" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.vps.output
  labels           = { environment = "production", host = sys.env("HOST_ID") }
  refresh_interval = "15s"
  forward_to       = [loki.process.vps.receiver]
}

loki.process "vps" {
  stage.decolorize {}
  forward_to = [loki.write.homelab.receiver]
}

loki.write "homelab" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}
