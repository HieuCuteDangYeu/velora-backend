381.0064" /><mxPoint x="2806.416" y="723.0103999999999" /><mxPoint x="1533.2746666666667" y="723.0103999999999" /></Array></mxGeometry></mxCell><mxCell id="E01-identity-social-e5_second_multiplicity0" value="0..*" vertex="1" parent="E01-identity-social-e5_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;fontColor=light-dark(#202020,#eeeeee);fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e5_second_multiplicity1" value="1" vertex="1" parent="E01-identity-social-e5_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;fontColor=light-dark(#202020,#eeeeee);fillColor=none;spacing=0;"><mxGeometry as="geometry" x="1" y="0" width="15" height="20" relative="1"><mxPoint x="6.0" y="-26.0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="13-content" name="13 · Reel, Series and sharing entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="2495.0" pageHeight="1666.992" shadow="0" adaptiveColors="auto" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. UNIQUE(seriesId,episodeNumber) orders episodes. ViewSession PK is (userId,reelId,playbackSessionId). ViewEvent UNIQUE(userId,reelId,playbackSessionId,sequence). Outbox aggregate and playback-session correlation links have no declared FK. series: seriesId; nullable; onDelete SetNull (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); aggregate: aggregateId when aggregateType=REEL (logical) (scalar-ID association; no declared FK); playback session: userId + reelId + playbackSessionId correlation (scalar-ID association; no declared FK) Operational upload/media-attempt lease rows are Content-owned; their publishIntentId/mediaKey and reelId/attemptId links are logical correlations, not declared Prisma FKs. ReelSubtitleTrack UNIQUE(reelId, language); reel: reelId cascade delete (declared SQL FK); sourceHash ties a track to the transcript it was translated from. ReelRerankExposure PK is (feedSessionId, reelId); its userId and reelId are logical scalar IDs joined to ReelViewEvent, not declared FKs. Reel.searchTags is a normalized copy of tags kept by a database trigger and indexed with GIN."><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="E02-content-e1" value="series" edge="1" parent="1" source="Reel" target="ReelSeries" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=light-dark(#202020,#eeeeee);strokeWidth=1;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.43199999999999983;exitY=0.9999999999999994;entryX=0.5;entryY=0.0;endArrow=none;fontFamily=Arial;fontSize=15;fontColor=light-dark(#202020,#eeeeee);labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:144-263&quot;]" relationKind="association" enforcement="declared relation"><mxGeometry as="geometry" relative="1" x="0.39802323941675866" y="26.0"><Array as="points"><mxPoint x="1218.0639999999999" y="1222.390944" /><mxPoint x="1247.984" y="1222.390944" /></Array></mxGeometry></mxCell><mxCell id="E02-content-e1_multiplicity0" value="0..