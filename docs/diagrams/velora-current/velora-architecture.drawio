metry x="195" y="2401" width="1790" height="70" as="geometry" /></mxCell><mxCell id="flow37" value="5 · Memory write: text with a high-severity finding is never stored, so an attack that was answered once cannot persist" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;text;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" sourceEvidence="[&quot;backend:apps/ai-service/src/application/use-cases/screen-rag-memory.use-case.ts:26-50&quot;]"><mxGeometry x="203" y="2423" width="1770" height="44" as="geometry" /></mxCell><mxCell id="flow38" value="ref" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;shape=umlFrame;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.6;fillOpacity=55;fontColor=#D97706;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" sourceEvidence="[&quot;backend:apps/ai-service/src/application/use-cases/screen-rag-memory.use-case.ts:45-50&quot;]"><mxGeometry x="180" y="2536" width="1820" height="70" as="geometry" /></mxCell><mxCell id="flow39" value="A guardrail failure never takes chat down: every check fails open and logs the error. Text from a failed check is not a reason to refuse." vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;text;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" sourceEvidence="[&quot;backend:apps/ai-service/src/application/use-cases/screen-rag-memory.use-case.ts:45-50&quot;]"><mxGeometry x="188" y="2558" width="1800" height="44" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="43c-ai-conversation-recall" name="43c · Recalling earlier messages, saved facts and photo descriptions"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="2731" background="#ffffff" adaptiveColors="none" conformance="Practical UML se