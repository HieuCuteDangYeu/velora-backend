uot;]" messageSort="synchCall" fromParticipant="mobile" toParticipant="mobile" order="29"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="4679" as="sourcePoint" /><mxPoint x="130" y="4703" as="targetPoint" /><Array as="points"><mxPoint x="164" y="4679" /><mxPoint x="164" y="4703" /></Array></mxGeometry></mxCell><mxCell id="s44_label" value="29. Retain credentials and&lt;br&gt;stable request ID; propagate&lt;br&gt;error" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/api/client.ts:69-80&quot;]"><mxGeometry x="172" y="4606" width="235" height="68" as="geometry" /></mxCell><mxCell id="s45" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1" sourceEvidence="[&quot;mobile:src/api/client.ts:82-87&quot;]" messageSort="synchCall" fromParticipant="mobile" toParticipant="mobile" order="30"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="4913" as="sourcePoint" /><mxPoint x="130" y="4937" as="targetPoint" /><Array as="points"><mxPoint x="164" y="4913" /><mxPoint x="164" y="4937" /></Array></mxGeometry></mxCell><mxCell id="s45_label" value="30. Created refreshPromise&lt;br&gt;finally clears itself; joined&lt;br&gt;callers await same promise" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/api/client.ts:82-87&quot;]"><mxGeometry x="172" y="4840" width="235" height="68" as="geometry" /></mxCell><mxCell id="title" value="20 · Concurrent refresh and retry identity" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1899" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Single-flight client; request-bound recovery; invalid JWT and inactive tokens do not trigger global revocation." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1899" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Logical RPC arrows show the caller awaiting a correlated RabbitMQ response; transport envelopes are abstracted.&lt;br&gt;Revoked recovery predicate is exactly repository checks: old request identity+window and valid encrypted replacement; absolute-expiry check belongs to active nonrevoked branch.&lt;br&gt;Rotation-conflict fallback checks request identity/window then reads replacement; it is not claimed to repeat every revoked-recovery check (auth.repository.ts:192-220)." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="5036" width="1899" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="21-auth-authorization" name="21 · Protected resource authorization"><mxGraphModel page="0" pageWidth="2220" pageHeight="2997" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;21-auth-authorization&quot;,&quot;title&quot;:&quot;21 \u00b7 Protected resource authorization&quot;,&quot;subtitle&quot;:&quot;One protected route: GET /content/series/:id/episodes; JWT verification precedes resource policy.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;mobi