mxCell id="11a-dfd-memory-f7-background" value="" style="fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1043.9" y="678.0" width="112.2" height="26" as="geometry" /></mxCell><mxCell id="11a-dfd-memory-f7-label" value="Updated memory" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1043.9" y="678.0" width="112.2" height="26" as="geometry" /></mxCell><mxCell id="legend" value="Blue box: outside participant. Green box: process. Grey open-ended box: stored data. * repeats the same participant or record family; it is not a new system/store. Text with a high-severity guardrail finding is never stored (43b). Memory updates are&lt;br&gt;conditional on feature/cadence gates and run after response persistence. Failed updates preserve/skip memory appropriately. These controls remain in sequences 40a and 40b and the source dictionary." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="971.0" width="1460" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="12-identity-social" name="12 · Identity and social entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="2500" pageHeight="1095.0" shadow="0" adaptiveColors="none" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. Friendship pair UNIQUE(userOneId,userTwoId); UserBlock PK(blockerId,blockedUserId); UserRole UNIQUE(userId,roleId). Cross-service user references and refresh replacement IDs are not database foreign keys. Multiplicity describes each named role; two-role links do not mean one shared user. role: roleId to id (declared SQL FK); user: userId to id (logical) (scalar-ID association; no declared FK); token owner: userId to id (logical) (scalar-ID association; no declared FK); requester: requesterId to User.id (scalar-ID association; no declared FK); recipient: recipientId to User.id; logical scalar IDs, no cross-service FK; blocker: blockerId to User.id (scalar-ID association; no declared FK); blocked user: blockedUserId to User.id; logical scalar IDs, no cross-service FK; successor: replacedByTokenId: optional logical successor (scalar-ID association; no declared FK)"><root><mxCell id="0" style="fontFamily=Helvetica;" value="" /><mxCell id="1" parent="0" style="fontFamily=Helvetica;" value="" /><mxCell id="E01-identity-social-e1" value="role" edge="1" parent="1" source="UserRole" target="Role" style="html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" sourceEvidence="[&quot;backend:apps/auth-service/prisma/schema.prisma:24-45&quot;]" relationKind="association" enforcement="declared relation"><mxGeometry as="geometry" relative="1" x="0.4758918078958869" y="18.5"><Array as="points" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e1_multiplicity0" value="0..*" vertex="1" parent="E01-identity-social-e1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeom