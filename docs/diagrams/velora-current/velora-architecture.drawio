ation/use-cases/complete-reel-media-processing.use-case.ts:1-50&quot;,&quot;backend:apps/media-processing-service/src/application/use-cases/prepare-reel-media.use-case.ts:1-689&quot;,&quot;backend:apps/media-service/src/application/use-cases/get-presigned-url.use-case.ts:1-103&quot;,&quot;backend:apps/media-service/src/infrastructure/services/s3.service.ts:1-165&quot;,&quot;mobile:src/components/reels/ReelVideo.tsx:1-751&quot;,&quot;mobile:src/hooks/useReels.ts:1-1689&quot;]},{&quot;id&quot;:&quot;08-dfd-media-f11&quot;,&quot;source&quot;:&quot;output&quot;,&quot;target&quot;:&quot;p3&quot;,&quot;label&quot;:&quot;Media references&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/complete-reel-media-processing.use-case.ts:1-50&quot;,&quot;backend:apps/media-processing-service/src/application/use-cases/prepare-reel-media.use-case.ts:1-689&quot;,&quot;backend:apps/media-service/src/application/use-cases/get-presigned-url.use-case.ts:1-103&quot;,&quot;backend:apps/media-service/src/infrastructure/services/s3.service.ts:1-165&quot;,&quot;mobile:src/components/reels/ReelVideo.tsx:1-751&quot;,&quot;mobile:src/hooks/useReels.ts:1-1689&quot;]}],&quot;layout&quot;:&quot;chain&quot;,&quot;recordFamilies&quot;:{&quot;D1&quot;:&quot;Account and social records&quot;,&quot;D2&quot;:&quot;Reel / Series / sharing records&quot;,&quot;D3&quot;:&quot;Media and semantic evidence&quot;,&quot;D4&quot;:&quot;Conversation and memory records&quot;,&quot;D5&quot;:&quot;Discovery and feed records&quot;},&quot;recordOwners&quot;:{&quot;D1&quot;:[&quot;Auth&quot;,&quot;User&quot;,&quot;Friend&quot;],&quot;D2&quot;:[&quot;Content&quot;],&quot;D3&quot;:[&quot;Media/R2&quot;,&quot;Media Processing&quot;,&quot;Reel Indexing&quot;,&quot;Mobile media cache&quot;],&quot;D4&quot;:[&quot;Conversation/Mongo&quot;,&quot;AI/PostgreSQL&quot;],&quot;D5&quot;:[&quot;Content playback records&quot;,&quot;Content feed/cache records&quot;]},&quot;scope&quot;:&quot;Payment, call, notification and ordinary conversation excluded; AI and Reel-sharing retained.&quot;,&quot;note&quot;:&quot;Accept-original includes mobile direct upload. Presigning binds one publishIntentId to a deterministic user-owned key and 24-hour Content upload lease; the signed PUT expires in 300 seconds and returns 412 when already present. Media completion persists validated HLS/thumbnail and queues evidence; attempt fencing, source preservation and opt-in cleanup are sequences 27–31.&quot;,&quot;requestEnvelope&quot;:&quot;Authenticated actor/viewer and operation-specific Reel/conversation/target/session IDs are part of request datasets; public-link requests use token context.&quot;,&quot;layoutBoxes&quot;:{&quot;p1&quot;:[280,390,240,110],&quot;p2&quot;:[630,390,240,110],&quot;p3&quot;:[980,390,240,110],&quot;u&quot;:[25,395,140,100],&quot;uout&quot;:[1340,395,160,100],&quot;reel&quot;:[260,145,280,90],&quot;original&quot;:[260,700,280,90],&quot;source&quot;:[610,700,280,90],&quot;derived&quot;:[610,145,280,90],&quot;catalog&quot;:[960,145,280,90],&quot;output&quot;:[960,700,280,90]},&quot;layoutRoutes&quot;:{&quot;08-dfd-media-f1&quot;:[[165,445.0],[280,445.0]],&quot;08-dfd-media-f2&quot;:[[1220,445.0],[1340,445.0]],&quot;08-dfd-media-f3&quot;:[[520,445.0],[630,445.0]],&quot;08-dfd-media-f4&quot;:[[870,445.0],[980,445.0]],&quot;08-dfd-media-f5&quot;:[[400.0,235],[400.0,390]],&quot;08-dfd-media-f6&quot;:[[400.0,500],[400.0,700]],&quot;08-dfd-media-f7&quot;:[[750.0,700],[750.0,500]],&quot;08-dfd-media-f8&quot;:[[750.0,390],[750.0,235]],&quot;08-dfd-media-f9&quot;:[[1150.0,235],[1150.0,390]],&quot;08-dfd-media-f10&quot;:[[1050.0,390],[1050.0,235]],&quot;08-dfd-media-f11&quot;:[[1100.0,700],[1100.0,500]]},&quot;layoutLabels&quot;:{&quot;08-dfd-media-f3&quot;:[537.15,414.0,75.7,62],&quot;08-dfd-media-f4&quot;:[890.8,414.0,68.4,62],&quot;08-dfd-media-f1&quot;:[177.35,414.0,90.3,62],&quot;08-dfd-media-f2&quot;:[1234.85,423.0,90.3,44],&quot;08-dfd-media-f5&quot;:[329.3,29