generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/notification-client"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

model PushToken {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  provider            String
  platform            String
  token               String
  deviceId            String?  @map("device_id")
  appVersion          String?  @map("app_version")
  bundleId            String?  @map("bundle_id")
  deliveryEnvironment String?  @map("delivery_environment")
  isActive            Boolean  @default(true) @map("is_active")
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([provider, token])
  @@index([userId, isActive])
  @@index([provider, platform])
  @@index([lastSeenAt])
  @@map("push_tokens")
}

model NotificationJob {
  id              String    @id @default(uuid())
  type            String
  recipientUserId String    @map("recipient_user_id")
  actorUserId     String?   @map("actor_user_id")
  conversationId  String?   @map("conversation_id")
  messageId       String?   @map("message_id")
  callId          String?   @map("call_id")
  title           String
  body            String
  dataJson        Json?     @map("data_json")
  expiresAt       DateTime? @map("expires_at")
  status          String    @default("pending")
  idempotencyKey  String?   @unique @map("idempotency_key")
  attemptCount    Int       @default(0) @map("attempt_count")
  nextAttemptAt   DateTime? @map("next_attempt_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sentAt          DateTime? @map("sent_at")

  @@index([status, nextAttemptAt])
  @@index([recipientUserId, createdAt])
  @@index([type, createdAt])
  @@index([conversationId])
  @@index([callId])
  @@map("notification_jobs")
}
