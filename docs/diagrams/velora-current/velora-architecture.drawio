/><Array as="points"><mxPoint x="164" y="2813" /><mxPoint x="164" y="2837" /></Array></mxGeometry></mxCell><mxCell id="s30_label" value="22. Set lastError; stop retry&lt;br&gt;despite error" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:539-543&quot;]"><mxGeometry x="172" y="2760" width="235" height="48" as="geometry" /></mxCell><mxCell id="s25_guard1" value="[create HTTP response lost or request fails before createdReel is assigned]" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReels.ts:1294-1313&quot;]"><mxGeometry x="183" y="2911" width="1404" height="26" as="geometry" /></mxCell><mxCell id="s31" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]" messageSort="synchCall" fromParticipant="mobile" toParticipant="mobile" order="23"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="3019" as="sourcePoint" /><mxPoint x="130" y="3043" as="targetPoint" /><Array as="points"><mxPoint x="164" y="3019" /><mxPoint x="164" y="3043" /></Array></mxGeometry></mxCell><mxCell id="s31_label" value="23. Catch error without&lt;br&gt;reelCreated marker; next&lt;br&gt;attempt starts fresh upload" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]"><mxGeometry x="172" y="2946" width="235" height="68" as="geometry" /></mxCell><mxCell id="s9_guard1" value="[PUT throws]" vertex="1" parent="1" sty