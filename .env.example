# Groq credentials (secret must be supplied outside source control)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low
GROQ_STRUCTURED_STRICT=false

# Temporary Workers AI vision exception. This is the only production inference
# path that remains on Cloudflare until Ollama vision is qualified separately.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ENABLED=true
CLOUDFLARE_AI_GATEWAY_ID=default

# Notification registration. Generate this once (for example: `openssl rand -hex 32`)
# and provide the same value to both the API gateway and notification service.
NOTIFICATION_SERVICE_URL=http://notification-service:3015
NOTIFICATION_GATEWAY_SECRET=

# Qualified Groq role partition. The final live canary remains a separate
# validation step; activating this configuration does not run that canary.
AI_ROUTER_MODEL=qwen/qwen3.8-27b
AI_ROUTER_FALLBACK_MODEL=
AI_RETRIEVAL_PLANNER_MODEL=qwen/qwen3.8-27b
AI_RETRIEVAL_TOOL_MODEL=openai/gpt-oss-20b
AI_CONTEXT_SUFFICIENCY_MODEL=openai/gpt-oss-20b
AI_ANSWER_MODEL=openai/gpt-oss-120b
AI_ANSWER_REVISION_MODEL=qwen/qwen3.8-27b
AI_VERIFIER_MODEL=openai/gpt-oss-120b
AI_VERIFIER_ESCALATION_MODEL=openai/gpt-oss-20b
AI_CITATION_ATTRIBUTION_MODEL=openai/gpt-oss-20b
AI_INDEX_QUALITY_MODEL=openai/gpt-oss-20b
AI_METADATA_EXTRACTION_MODEL=openai/gpt-oss-20b
AI_SECTION_SUMMARY_MODEL=openai/gpt-oss-20b
AI_VISION_PROVIDER=cloudflare
AI_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
AI_VISION_VERSION=cf-llama-4-scout-vision-2026-08
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_TRANSCRIPTION_VERSION=groq-whisper-large-v3-turbo-v1
AI_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EVAL_JUDGE_MODEL=
RAG_EVAL_EMBEDDING_MODEL=
RAG_EVAL_CLOUDFLARE_BASE_URL=
RAG_EVAL_CAPACITY_MODEL=openai/gpt-oss-20b
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_VERSION=bge-m3-tei-v1
AI_EMBEDDING_BATCH_CONCURRENCY=4
INDEX_EMBEDDING_PROVIDER=self-hosted-tei
INDEX_TRANSCRIPTION_PROVIDER=groq
AI_RERANKER_PROVIDER=tei
AI_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
AI_CONVERSATION_SUMMARY_MODEL=openai/gpt-oss-20b
AI_MEMORY_EXTRACTION_MODEL=openai/gpt-oss-20b

# Evaluation persistence is opt-in and targets only the reel-indexing DB.
REEL_INDEXING_DATABASE_URL=
RAG_EVAL_PERSIST_CONFIRM=NO

# Internal local-model endpoints. Keep these on the Docker network.
TEI_EMBEDDING_BASE_URL=http://rag-embedding:80
TEI_EMBEDDING_MODEL=BAAI/bge-m3
TEI_EMBEDDING_MAX_CONCURRENT_REQUESTS=8
TEI_EMBEDDING_MAX_BATCH_TOKENS=1024
TEI_RERANKER_BASE_URL=http://rag-reranker:80
TEI_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TEI_RERANKER_MAX_CONCURRENT_REQUESTS=8
TEI_RERANKER_MAX_BATCH_TOKENS=1024
OLLAMA_BASE_URL=http://rag-vision:11434

# Bounded role policy
AI_ROUTER_TIMEOUT_MS=30000
AI_ROUTER_PRIMARY_MAX_ATTEMPTS=1
AI_ROUTER_FALLBACK_TIMEOUT_MS=60000
AI_RETRIEVAL_PLANNER_TIMEOUT_MS=8000
AI_RETRIEVAL_TOOL_TIMEOUT_MS=8000
AI_CONTEXT_SUFFICIENCY_TIMEOUT_MS=12000
AI_ANSWER_TIMEOUT_MS=45000
AI_ANSWER_REVISION_TIMEOUT_MS=30000
AI_VERIFIER_TIMEOUT_MS=12000
AI_ROUTER_MAX_TOKENS=512
AI_RETRIEVAL_PLANNER_MAX_TOKENS=512
AI_RETRIEVAL_TOOL_MAX_TOKENS=500
AI_CONTEXT_SUFFICIENCY_MAX_TOKENS=512
AI_ANSWER_MAX_TOKENS=1536
AI_ANSWER_REVISION_MAX_TOKENS=768
AI_VERIFIER_MAX_TOKENS=650
AI_VERIFIER_ESCALATION_MAX_TOKENS=1024
AI_CITATION_MAX_TOKENS=768
AI_INDEX_QUALITY_MAX_TOKENS=768
AI_METADATA_EXTRACTION_MAX_TOKENS=512
AI_SECTION_SUMMARY_MAX_TOKENS=512
GROQ_MEMORY_MAX_TOKENS=650
GROQ_MEMORY_EXTRACTION_MAX_TOKENS=350
AI_VERIFIER_ESCALATION_TIMEOUT_MS=30000
AI_CITATION_TIMEOUT_MS=12000
AI_VISION_TIMEOUT_MS=30000
AI_TRANSCRIPTION_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=12000
AI_RAG_NEURAL_RERANK_TIMEOUT_MS=5000
AI_RAG_NEURAL_RERANK_ENABLED=true
AI_RAG_NEURAL_RERANK_CANDIDATE_LIMIT=8
AI_RAG_RERANK_MAX_LIMIT=8
AI_VERIFIER_ESCALATION_ENABLED=true
AI_VERIFIER_ESCALATION_CONFIDENCE_THRESHOLD=0.80
AI_VERIFIER_MAX_ATTEMPTS=2
AI_RERANKER_MAX_INPUT_TOKENS=512

# Provider-neutral bounds for context serialized into normal RAG prompts.
# These cap history, summary, memory, and post-rerank evidence independently;
# retrieval and reranking candidate limits remain separate controls.
RAG_PROMPT_MAX_USER_MESSAGE_CHARS=1200
RAG_PROMPT_MAX_ANSWER_CHARS=2500
RAG_PROMPT_MAX_CLAIM_CHARS=500
RAG_PROMPT_MAX_CLAIMS=12
RAG_PROMPT_MAX_CLAIMS_TOTAL_CHARS=3000
RAG_PROMPT_MAX_RECENT_MESSAGES=4
RAG_PROMPT_MAX_ROUTER_EVENT_TYPES=16
RAG_PROMPT_MAX_RECENT_MESSAGE_CHARS=400
RAG_PROMPT_MAX_RECENT_TOTAL_CHARS=1200
RAG_PROMPT_MAX_SUMMARY_CHARS=800
RAG_PROMPT_MAX_MEMORIES=4
RAG_PROMPT_MAX_MEMORY_ITEM_CHARS=240
RAG_PROMPT_MAX_MEMORY_TOTAL_CHARS=800
RAG_PROMPT_MAX_EVIDENCE_ITEMS=5
RAG_PROMPT_MAX_EVIDENCE_CHARS=500
RAG_PROMPT_MAX_EVIDENCE_TOTAL_CHARS=2200
RAG_PROMPT_MAX_EVIDENCE_TITLE_CHARS=200
RAG_PROMPT_MAX_EVIDENCE_DESCRIPTION_CHARS=350
RAG_PROMPT_MAX_EVIDENCE_TAGS=8
RAG_PROMPT_MAX_EVIDENCE_TAG_CHARS=80

# Local model qualification safety. These values are consumed only by
# scripts/ops/check-local-ai-capacity.sh; they do not change application
# runtime behavior.
LOCAL_AI_MIN_FREE_DISK_GB=12
LOCAL_AI_DISK_PATH=/var/lib/docker
GROQ_TEXT_TIMEOUT_MS=45000
GROQ_STRUCTURED_TIMEOUT_MS=45000
GROQ_TOOL_TIMEOUT_MS=10000
PROMETHEUS_URL=http://prometheus:9090
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Index identity. Reindexing and activation are explicit operations.
INDEX_EMBEDDING_CONCURRENCY=4

# Prometheus + Grafana monitoring. Prometheus remains internal to the Docker
# network for application queries; Grafana/Prometheus host ports bind to
# localhost in the root Docker Compose topology. Node exporter exposes host
# CPU/RAM/swap/disk metrics only inside the Docker network.
PROMETHEUS_QUERY_TIMEOUT_MS=4000
PROMETHEUS_MEMORY_LIMIT=512m
NODE_EXPORTER_MEMORY_LIMIT=64m
GRAFANA_MEMORY_LIMIT=384m
GRAFANA_ADMIN_USER=admin
# Required for the homelab Grafana deployment. Generate a strong secret.
GRAFANA_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_USERS_ALLOW_SIGN_UP=false
GF_PLUGINS_PREINSTALL_DISABLED=true
GF_PLUGINS_PREINSTALL_AUTO_UPDATE=false
GF_PLUGINS_DISABLE_PLUGINS=elasticsearch,grafana-postgresql-datasource,grafana-pyroscope-datasource,influxdb,jaeger,loki,mssql,mysql,opentsdb,stackdriver,tempo,zipkin,grafana-metricsdrilldown-app,grafana-advisor-app,grafana-pyroscope-app,grafana-exploretraces-app,grafana-lokiexplore-app
GF_UNIFIED_ALERTING_ENABLED=false
GF_LIVE_MAX_CONNECTIONS=0
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
