# Safe defaults only. Supply a server-side RAG_EVAL_ENV_FILE for live work.
RAG_EVAL_CAPACITY_MODEL=@cf/openai/gpt-oss-20b

# Judge pacing defaults. Credentials and provider endpoints are intentionally
# omitted from this example file.
RAGAS_JUDGE_CONCURRENCY=1
RAGAS_GROQ_TPM_LIMIT=8000
RAGAS_GROQ_TPM_TARGET=6000
# Preflight probes only the next provider operation. TPD must come from an
# independent operator-supplied Groq Console/usage attestation, never from
# x-ratelimit-remaining-tokens (which is TPM).
RAGAS_PREFLIGHT_MODELS=openai/gpt-oss-120b
RAGAS_PREFLIGHT_FIRST_MODEL=openai/gpt-oss-120b
RAGAS_PREFLIGHT_FIRST_OPERATION_TOKENS=6000
# The limit and current-window baseline are separate operator attestations.
# A limit-only attestation never establishes remaining TPD by itself.
# RAGAS_GROQ_TPD_LIMIT_ATTESTATION_PATH=/secure/path/groq-tpd-limit.json
# RAGAS_GROQ_TPD_WINDOW_ATTESTATION_PATH=/secure/path/groq-tpd-window.json
# RAGAS_GROQ_TPD_ATTESTATION_PATH=/secure/path/groq-tpd-window.json
# RAGAS_GROQ_TPD_COST_ATTESTATION_PATH=/secure/path/groq-tpd-cost.json
# RAGAS_GROQ_TPD_USAGE_ATTESTATION_PATH=/secure/path/groq-tpd-usage-baseline.json
# RAGAS_GROQ_TPD_EMPTY_ATTESTATION_PATH=/secure/path/groq-tpd-empty-baseline.json
# RAGAS_GROQ_PRICING_PATH=/secure/path/groq-pricing-v1.json
# Persist outside Git; every Groq judge attempt is counted here.
# RAGAS_GROQ_DAILY_LEDGER_PATH=/secure/path/groq-tpd-ledger.jsonl
RAGAS_GROQ_TPD_ATTESTATION_MAX_AGE_SECONDS=3600
RAGAS_GROQ_TPD_PLANNED_FULL_RUN_TOKENS=54048
RAGAS_GROQ_PRICING_MAX_AGE_SECONDS=2592000
RAGAS_RATE_LIMIT_HEADROOM_RATIO=0.25
RAGAS_TOKEN_ESTIMATE_SAFETY_TOKENS=256
RAGAS_RATE_LIMIT_JITTER_MAX_SECONDS=0.25
# Bound one external judge request; timeouts use the normal transient retry policy.
RAGAS_JUDGE_TIMEOUT_SECONDS=120
# Groq GPT-OSS structured outputs reached the JSON budget at 256 tokens; keep
# the evidence-backed 512-token default for ordinary metrics. Faithfulness has
# two larger intermediate structured outputs and uses its own budget/reservation.
RAGAS_MAX_COMPLETION_TOKENS=512
RAGAS_FAITHFULNESS_MAX_COMPLETION_TOKENS=2048
RAGAS_FAITHFULNESS_OPERATION_RESERVATION_TOKENS=12000
RAGAS_JUDGE_429_MAX_RETRIES=2
RAGAS_RATE_LIMIT_HEADERS_ENABLED=true
RAGAS_RESUME_COMPLETED_JUDGE_RESULTS=true
# Multi-day saved-output recovery: semantic checkpoints are run-scoped while
# each Groq UTC-day quota epoch is persisted separately. A slice must leave
# this margin uncommitted. Keep state/operation files outside Git.
RAGAS_MULTI_DAY_DAILY_SAFETY_MARGIN_TOKENS=10000
# RAGAS_MULTI_DAY_RECOVERY_STATE_PATH=/secure/path/ragas-multiday-recovery.json
# RAGAS_MULTI_DAY_RECOVERY_OPERATIONS_PATH=/secure/path/ragas-pending-operations.json
