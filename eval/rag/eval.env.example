# Safe defaults only. Supply a server-side RAG_EVAL_ENV_FILE for live work.
RAG_EVAL_CAPACITY_MODEL=@cf/openai/gpt-oss-20b

# Judge pacing defaults. Credentials and provider endpoints are intentionally
# omitted from this example file.
RAGAS_JUDGE_CONCURRENCY=1
RAGAS_GROQ_TPM_LIMIT=8000
RAGAS_GROQ_TPM_TARGET=6000
RAGAS_RATE_LIMIT_HEADROOM_RATIO=0.25
RAGAS_TOKEN_ESTIMATE_SAFETY_TOKENS=256
RAGAS_RATE_LIMIT_JITTER_MAX_SECONDS=0.25
# Groq GPT-OSS structured outputs reached the JSON budget at 256 tokens; keep
# the evidence-backed 512-token default unless an evaluator-specific override is
# intentional.
RAGAS_MAX_COMPLETION_TOKENS=512
RAGAS_JUDGE_429_MAX_RETRIES=2
RAGAS_RATE_LIMIT_HEADERS_ENABLED=true
RAGAS_RESUME_COMPLETED_JUDGE_RESULTS=true
