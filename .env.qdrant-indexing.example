# Private deployment file. Keep secret files outside the checkout.
REEL_INDEXING_DATABASE_URL=postgresql://reel_indexing_app:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@reel-indexing-postgres:5432/reel_indexing?schema=public
REEL_INDEXING_PRIVATE_ENV_FILE=/absolute/private/path/.env.qdrant-indexing
QDRANT_SECRET_DIR=/absolute/private/path/qdrant-secrets
REEL_INDEXING_DB_ADMIN_PASSWORD_FILE=/absolute/private/path/qdrant-secrets/reel-indexing-db/admin-password
REEL_INDEXING_DB_APP_PASSWORD_FILE=/absolute/private/path/qdrant-secrets/reel-indexing-db/app-password
REEL_INDEXING_PG_INIT_DIR=/absolute/private/path/postgres-init
INDEX_VECTOR_SEARCH_BACKEND=qdrant
INDEX_VECTOR_PROJECTION_ENABLED=true
INDEX_VECTOR_PUBLICATION_REQUIRED=true
