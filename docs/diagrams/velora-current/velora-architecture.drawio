t="synchCall" fromParticipant="mobile" toParticipant="mobile" order="25"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="3503" as="sourcePoint" /><mxPoint x="130" y="3527" as="targetPoint" /><Array as="points"><mxPoint x="164" y="3503" /><mxPoint x="164" y="3527" /></Array></mxGeometry></mxCell><mxCell id="s33_label" value="25. Catch presign error; no&lt;br&gt;PUT/create; repeat if attempt&lt;br&gt;remains" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReels.ts:1280-1281&quot;, &quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]"><mxGeometry x="172" y="3430" width="235" height="68" as="geometry" /></mxCell><mxCell id="s34_guard0" value="[!createdReel]" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:547-555&quot;]"><mxGeometry x="118" y="3665" width="1534" height="26" as="geometry" /></mxCell><mxCell id="s35" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:547-555&quot;]" messageSort="synchCall" fromParticipant="mobile" toParticipant="mobile" order="26"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="3753" as="sourcePoint" /><mxPoint x="130" y="3777" as="targetPoint" /><Array as="points"><mxPoint x="164" y="3753" /><mxPoint x="164" y="3777" /></Array></mxGeometry></mxCell><mxCell id="s35_label" value="26. Show publish failure and&lt;br&gt;return" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;mobile:src/hooks/useReelCreator.ts:547-555&quot;]"><mxGeometry x="172" y="3700" width="235" height="48" as="geometry" /></mxCell><mxCell id="title" value="27 · Upload retry and duplicate effects" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1634" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="At most two whole upload/create attempts; fresh object key and Reel/outbox identities can duplicate effects after a lost create response." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1634" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Loop uses logical stop conditions equivalent to source for-loop plus break, not an idempotency key. Presign/upload failures skip the later steps inside explicit operands.&lt;br&gt;A server commit followed by lost HTTP response leaves no known reelCreated marker; another attempt generates a different random object key and new Reel/outbox IDs.&lt;br&gt;The storage SDK presigns locally; no fabricated Media-&amp;gt;R2 presign network request. Logical RMQ RPC abstracts envelopes; presign and upload failure operands stop later steps.&lt;br&gt;Current mobile getReelUploadUrl sends fileType only; gateway purpose defaults to chat, so video key uses chat-videos rather than an assumed reels prefix. This is current source behavior, not an app change." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="3876" width="1634" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="28-media-processing" name="28 · Processing and HLS publication"><mxGraphModel page="0" pageWidth="2220" pageHeight="5942" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;28-media-processing&quot;,&quot;title&quot;:&quot;28 \u00b7 Processing and HLS publication&quot;,&quot;subtitle&quot;:&quot;Claimed attempt branches ORIGINAL vs EXISTING_HLS; post-validation visual evidence; durable handling and protocol ACK/NACK.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;broker&quot;,&quot;label&quot;:&quot;RabbitMQ jobs/retry/DLQ&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.ts:25-81&quot;]},{&quot;id&quot;:&quot;handler&quot;,&quot;label&quot;:&quot;Media job handler / retry publisher&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.ts:25-82&quot;]},{&quot;id&quot;:&quot;media&quot;,&quot;label&quot;:&quot;Media processing use case&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-processing-service/src/application/use-cases/process-reel.use-case.ts:70-330&quot;]},{&quot;id&quot;:&quot;content&quot;,&quot;label&quot;:&quot;Content service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-processing-service/src/infrastructure/adapters/content-service.adapter.ts:46-62&quot;]},{&quot;id&quot;:&quot;db&quot;,&quot;label&quot;:&quot;Content private database/outbox&quot;,&quot;kind&quot;:&quot;store&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/infrastructure/repositories/content.repository.ts:378-553&q