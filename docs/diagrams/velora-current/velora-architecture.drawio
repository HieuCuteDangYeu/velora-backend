ollers/media-processing.controller.ts:44-62&quot;]"><mxGeometry x="300" y="5502" width="720" height="72" as="geometry" /></mxCell><mxCell id="s57_label" value="Attempt execute until claim/persist/other handling throws" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.ts:44-62&quot;]"><mxGeometry x="316" y="5530" width="688" height="42" as="geometry" /></mxCell><mxCell id="s58" edge="1" parent="1" style="html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=open;endFill=0" sourceEvidence="[&quot;backend:apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.ts:76-81&quot;]" messageSort="asynchSignal" fromParticipant="handler" toParticipant="broker" order="39"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="5653" as="sourcePoint" /><mxPoint x="130" y="5653" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s58_label" value="39. AMQP basic.nack(false,true);&lt;br&gt;requeue original" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=2;fontSize=14;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;" sourceEvidence="[&quot;backend:apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.ts:76-81&quot;]"><mxGeometry x="142" y="5600" width="240" height="48" as="geometry" /></mxCell><mxCell id="title" value="28 · Processing and HLS publication" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="2164" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Claimed attempt branches ORIGINAL vs EXISTING_HLS; post-validation visual evidence; durable handling and protocol ACK/NACK." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="2164" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;RabbitMQ business job delivery is asynchronous; ACK/NACK arrows are separate one-way AMQP protocol commands, not new business events.&lt;br&gt;Successful original preparation publishes to R2 whether CDN is disabled, succeeds, or fails. First R2 upload in configured try can also trigger its fallback catch.&lt;br&gt;Workspace cleanup runs in finally for claimed attempt. Progress events are awaited enqueue operations, not awaited consumer completion.&lt;br&gt;Exception operands explicitly terminate later pipeline stages. Retry/failure persistence occurs before the media-to-handler result; retry publication failure reaches NACK(requeue) inside its operand." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="5792" width="2164" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="29-index-normal" name="29 · Indexing evidence and embeddings"><mxGraphModel page="0" pageWidth="1955" pageHeight="6385" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;29-index-normal&quot;,&quot;title&quot;:&quot;29 \u00b7 Indexing evidence and embeddings&quot;,&quot;subtitle&quot;:&quot;Checkpointed visual/transcript fan-out; real NO_AUDIO/SHORT/LONG predicates; token gate 