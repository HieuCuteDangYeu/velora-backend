empts; fresh object key and Reel/outbox identities can duplicate effects after a lost create response.&quot;,&quot;participants&quot;:[{&quot;id&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Mobile Reel creator&quot;,&quot;kind&quot;:&quot;client&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:528-555&quot;]},{&quot;id&quot;:&quot;gateway&quot;,&quot;label&quot;:&quot;API Gateway&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/api-gateway/src/content/content.controller.ts:135-151&quot;]},{&quot;id&quot;:&quot;media&quot;,&quot;label&quot;:&quot;Media service (presign)&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/media-service/src/application/use-cases/get-presigned-url.use-case.ts:8-66&quot;]},{&quot;id&quot;:&quot;r2&quot;,&quot;label&quot;:&quot;R2 object storage&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/infrastructure/services/r2-storage.service.ts:35-46&quot;]},{&quot;id&quot;:&quot;content&quot;,&quot;label&quot;:&quot;Content service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:23-76&quot;]},{&quot;id&quot;:&quot;db&quot;,&quot;label&quot;:&quot;Content private Reel/outbox database&quot;,&quot;kind&quot;:&quot;store&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/infrastructure/repositories/content.repository.ts:230-300&quot;]}],&quot;steps&quot;:[{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;loop&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;attempt &lt; 2 &amp;&amp; !createdReel &amp;&amp; (!lastError || !lastError.reelCreated)&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;gateway&quot;,&quot;label&quot;:&quot;POST /media/upload-url {fileType}; DTO defaults purpose=chat&quot;,&quot