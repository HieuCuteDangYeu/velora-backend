" toParticipant="ai" order="3" sourceEvidence="[&quot;backend:apps/ai-service/src/application/use-cases/classify-rag-input.use-case.ts:16-40&quot;]"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="921" as="sourcePoint" /><mxPoint x="620" y="921" as="targetPoint" /><mxPoint x="0" y="-25" as="offset" /></mxGeometry></mxCell><mxCell id="flow19" value="alt" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;shape=umlFrame;fillColor=#EAF3FF;strokeColor=#2F80ED;strokeWidth=1.6;fillOpacity=40;fontColor=#2F80ED;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" sourceEvidence="[]" interactionOperator="alt"><mxGeometry x="130" y="1026" width="1930" height="1480" as="geometry" /></mxCell><mxCell id="flow20" value="[a high-severity finding and the input check enforces]" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;text;whiteSpace=wrap;align=left;strokeColor=none;fillColor=none;fontColor=#2F80ED;fontStyle=1;" sourceEvidence="[]"><mxGeometry x="155" y="1076" width="1870" height="45" as="geometry" /></mxCell><mxCell id="flow21" value="4. Fixed refusal at once: no model slot, no retrieval, no memory write" edge="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#ffffff;whiteSpace=wrap;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;strokeColor=#94A3B8;strokeWidth=1.6;labelWidth=560;align=center;" messageSort="reply" fromParticipant="ai" toParticipant="conv" order="4" sourceEvidence="[&quot;backend:apps/ai-service/src/application/use-cases/stream-chat.use-case.ts:66-90&quot;]"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1191" as="sourcePoint" /><mxPoint x="300" y="1191" as="targetPoint" /><mxPoint x="0" y="-25" as="offset" /></mxGeometry></mxCell><mxCell id="flow22" value="" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;fillColor=none;dashed=1;strokeColor=#2F80ED;" sourc