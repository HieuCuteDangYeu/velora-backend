t.use-case.ts:58-82&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;classifier&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;Verdict with confidence; it can only add a refusal, never lift one&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/classify-rag-input.use-case.ts:16-40&quot;]}]}]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;a high-severity finding and the input check enforces&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;conv&quot;,&quot;label&quot;:&quot;Fixed refusal at once: no model slot, no retrieval, no memory write&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/stream-chat.use-case.ts:66-90&quot;]}]},{&quot;guard&quot;:&quot;the message is allowed&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;ai&quot;,&quot;to&quot;:&quot;retrieval&quot;,&quot;label&quot;:&quot;Retrieve evidence for the question&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/infrastructure/adapters/langgraph-rag-chat-workflow.adapter.ts:374-398&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;2 · Evidence: a chunk with a high-severity injection finding is dropped before it reaches the prompt&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/domain/services/rag-guardrail/rag-guardrail.ts:90-114&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;retrieval&quot;,&quot;to&quot;:&quot;ai&quot;,&quot;label&quot;:&quot;Kept chunks and the findings for the dropped ones&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/ai-service/src/application/use-cases/screen-rag-result.use-case.ts:44-68&quot;]},{&quot;t