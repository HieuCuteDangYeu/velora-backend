rokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);"><mxGeometry as="geometry" x="35" y="1850" width="1450" height="160" /></mxCell><mxCell id="ReelUploadLease" value="&lt;b&gt;ReelUploadLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);fontFamily=Arial;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:163-192&quot;]"><mxGeometry x="35" y="1540" width="440" height="252" as="geometry" /></mxCell><mxCell id="ReelUploadLease_fields" value="id: String {PK}&lt;br&gt;userId: String&lt;br&gt;publishIntentId: String&lt;br&gt;mediaKey: String&lt;br&gt;fileType: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;adoptedAt: DateTime [0..1]&lt;br&gt;cancelledAt: DateTime [0..1]&lt;br&gt;cleanupClaimedAt: DateTime [0..1]&lt;br&gt;cleanupCompletedAt: DateTime [0..1]" vertex="1" parent="ReelUploadLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=15;fontColor=light-dark(#202020,#eeeeee);fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="200" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease" value="&lt;b&gt;ReelMediaAttemptLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=light-dark(#ffffff,#181818);strokeColor=light-dark(#202020,#eeeeee);fontColor=light-dark(#202020,#eeeeee);fontFamily=Arial;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:163-192&quot;]"><mxGeometry x="550" y="1540" width="440" height="148" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease_fields" value="attemptId: String {PK}&lt;br&gt;reelId: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;completedAt: DateTime [0..1]" vertex="1" parent="ReelMediaAttemptLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Arial;fontSize=15;fontColor=light-dark(#202020,#eeeeee);fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="96" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="14-semantic-hierarchy" name="14 · Semantic evidence entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="1469.0" pageHeight="1586.9840000000002" shadow="0" adaptiveColors="auto" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. {xor}: each chunk has either a section parent or a document parent; both links require the same indexAttemptId. Chunk has one parent selected by strategy: section OR document. The two optional parent links are alternatives, not simultaneous parents. Semantic tables use rowId PK and UNIQUE(id,indexAttemptId). Historical candidates can exist; retrieval serves accepted active rows.  Migrations declare partial uniqueness for active rows: at most one active ReelDocument per Reel, and one active section/chunk/scene per stable id. Live migration application is not probed. reel: reelId: cross-service reference (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); section parent: long-form chunk: parentId = sectionId (scalar-ID association; no declared FK); document parent: short/document chunk: parentId = reelDocumentId (scalar-ID association; no declared FK)"><root><mxCell id="0" style="font