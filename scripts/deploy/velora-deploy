#!/usr/bin/env bash
set -Eeuo pipefail

# Load the previously battle-tested deployment controller, but suppress its
# terminal main "$@" invocation so this file can override the small set of
# functions needed for the first-class Loki/Alloy migration.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CORE_SCRIPT="$SCRIPT_DIR/velora-deploy-core"
[[ -f "$CORE_SCRIPT" ]] || {
  printf 'ERROR: deployment core is missing: %s\n' "$CORE_SCRIPT" >&2
  exit 1
}
source <(sed '$d' "$CORE_SCRIPT")

compare_compose_models() {
  [[ -n "$LAST_DEPLOYED_SHA" ]] || return 0
  [[ -f "$BASE_COMPOSE_JSON" && -f "$TARGET_COMPOSE_JSON" ]] || return 0

  local base_normal target_normal service base_image target_image
  local app_image_model_changed=false

  for service in "${APP_SERVICES[@]}"; do
    base_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$BASE_COMPOSE_JSON")"
    target_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$TARGET_COMPOSE_JSON")"
    if [[ "$base_image" != "$target_image" ]]; then
      app_image_model_changed=true
      break
    fi
  done

  if [[ "$app_image_model_changed" == true ]]; then
    log "Application image model changed; reconciling all application services onto immutable SHA tags."
    add_all_application_services
  fi

  base_normal="$BASELINE_DIR/.velora-compose-base-normal.json"
  target_normal="$STAGING_DIR/.velora-compose-target-normal.json"
  normalize_compose_json "$BASE_COMPOSE_JSON" "$base_normal"
  normalize_compose_json "$TARGET_COMPOSE_JSON" "$target_normal"

  if ! jq -n -e --slurpfile a "$base_normal" --slurpfile b "$target_normal" \
    '($a[0].networks == $b[0].networks)' >/dev/null; then
    fail "top-level Compose networks changed; automatic deployment is intentionally blocked"
  fi

  # Keep the existing safety invariant for volumes, with one deliberate
  # migration exception: this release may add the persistent Loki/Alloy data
  # volumes. Existing volume definitions may not be removed or changed.
  if ! jq -n -e --slurpfile a "$base_normal" --slurpfile b "$target_normal" '
    (($a[0].volumes // {}) | to_entries) as $base
    | (($b[0].volumes // {}) | to_entries) as $target
    | all($base[]; . as $entry | (($b[0].volumes // {})[$entry.key] == $entry.value))
      and
      all($target[];
        . as $entry
        | (($a[0].volumes // {}) | has($entry.key))
          or ($entry.key == "loki_data")
          or ($entry.key == "alloy_data")
      )
  ' >/dev/null; then
    fail "top-level Compose volumes changed outside the approved Loki/Alloy additive migration"
  fi

  while IFS= read -r service; do
    [[ -n "$service" ]] || continue

    if jq -e --arg service "$service" '.services[$service] != null' "$base_normal" >/dev/null \
      && ! jq -e --arg service "$service" '.services[$service] != null' "$target_normal" >/dev/null; then
      fail "Compose service '$service' was removed; automatic service removal is intentionally blocked"
    fi

    if contains "$service" "${BLOCKED_COMPOSE_SERVICES[@]}"; then
      fail "Compose configuration changed for protected/worker service '$service'; manual review is required"
    fi

    if contains "$service" "${APP_SERVICES[@]}"; then
      add_app_and_worker_companions "$service"
      continue
    fi

    if contains "$service" "${MANAGED_INFRA_SERVICES[@]}" || [[ "$service" == "loki" || "$service" == "alloy" ]]; then
      add_unique "$service" INFRA_RECONCILE_SERVICES
      continue
    fi

    fail "Compose configuration changed for unmanaged service '$service'; manual review is required"
  done < <(
    jq -n -r --slurpfile a "$base_normal" --slurpfile b "$target_normal" '
      (($a[0].services // {}) + ($b[0].services // {}))
      | keys[] as $k
      | select(($a[0].services[$k] // null) != ($b[0].services[$k] // null))
      | $k
    '
  )
}

plan_from_changed_files() {
  local file service

  if [[ "$CHANGED_FILES" == "__INITIAL_RELEASE__" ]]; then
    add_all_application_services
    add_unique nginx INFRA_RECONCILE_SERVICES
    add_unique cadvisor INFRA_RECONCILE_SERVICES
    add_unique prometheus INFRA_RECONCILE_SERVICES
    add_unique node-exporter INFRA_RECONCILE_SERVICES
    add_unique loki INFRA_RECONCILE_SERVICES
    add_unique alloy INFRA_RECONCILE_SERVICES
    add_unique grafana INFRA_RECONCILE_SERVICES
    return
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue

    case "$file" in
      apps/*)
        service="${file#apps/}"
        service="${service%%/*}"
        if contains "$service" "${APP_SERVICES[@]}"; then
          add_app_and_worker_companions "$service"
        else
          warn "unknown app path '$file'; conservatively reconciling all application services"
          add_all_application_services
        fi
        ;;
      infra/nginx/*)
        add_unique nginx INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/prometheus/*)
        add_unique prometheus INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/grafana/*)
        add_unique grafana INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/loki/*)
        add_unique loki INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/alloy/*)
        add_unique alloy INFRA_RECONCILE_SERVICES
        ;;
      infra/monitoring/docker-compose.monitoring.yml|scripts/ops/check-monitoring-stack.sh)
        # The former overlay is removed by this migration. Root Compose model
        # differences and explicit monitoring config handlers cover runtime work.
        ;;
      docker-compose.yml|docker-compose.yaml|compose.yml|compose.yaml)
        ;;
      scripts/deploy/*)
        ;;
      package.json|pnpm-lock.yaml|pnpm-workspace.yaml|tsconfig.json|tsconfig.build.json|nest-cli.json|.npmrc|.dockerignore|Dockerfile|Dockerfile.*|libs/*|scripts/*|docker/*|infra/docker/*)
        add_all_application_services
        ;;
      .env.example|.github/*|docs/*|eval/rag/*|README|README.*|QWEN.md|CLAUDE.md|LICENSE*|*.md|.gitignore|.prettierrc|eslint.config.mjs|jest.config.cjs|.vscode/*|.codex/*|AGENTS.md)
        ;;
      *)
        warn "unknown tracked change '$file'; conservatively reconciling all application services"
        add_all_application_services
        ;;
    esac
  done <<<"$CHANGED_FILES"

  if [[ "$FORCE" == true ]]; then
    for service in "${FORCE_SAFE_APP_SERVICES[@]}"; do
      add_unique "$service" PULL_SERVICES
      add_unique "$service" RECONCILE_SERVICES
    done
  fi
}

prepull_managed_infra() {
  local service image base_image attempt existing_container
  (( ${#INFRA_RECONCILE_SERVICES[@]} > 0 )) || return 0

  log "==> Pre-pulling explicitly changed infrastructure images..."
  for service in "${INFRA_RECONCILE_SERVICES[@]}"; do
    image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$TARGET_COMPOSE_JSON")"
    [[ -n "$image" ]] || continue

    base_image=""
    if [[ -n "$BASE_COMPOSE_JSON" && -f "$BASE_COMPOSE_JSON" ]]; then
      base_image="$(jq -r --arg service "$service" '.services[$service].image // empty' "$BASE_COMPOSE_JSON")"
    fi

    if [[ -n "$base_image" && "$image" == "$base_image" ]]; then
      log "$service image reference unchanged ($image); skipping registry pull."
      continue
    fi

    if [[ -z "$base_image" ]]; then
      existing_container="$(
        docker ps -aq \
          --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}" \
          --filter "label=com.docker.compose.service=${service}" \
          | head -n 1
      )"
      if [[ -n "$existing_container" ]]; then
        log "$service has an existing container and no baseline release state; skipping automatic infra image refresh."
        continue
      fi
    fi

    for ((attempt=1; attempt<=PULL_ATTEMPTS; attempt++)); do
      log "Pulling changed infrastructure image $image (attempt $attempt/$PULL_ATTEMPTS)..."
      if docker pull "$image"; then
        break
      fi
      if (( attempt == PULL_ATTEMPTS )); then
        fail "failed to pull infrastructure image $image"
      fi
      sleep $((attempt * 5))
    done
  done
}

snapshot_services_json() {
  local from_sha="$1"
  local to_sha="$2"
  local output="$3"
  shift 3
  local -a services=("$@")
  local temp_entries temp_absent service container_id image_id tag
  temp_entries="$(mktemp)"
  temp_absent="$(mktemp)"
  : >"$temp_entries"
  : >"$temp_absent"

  for service in "${services[@]}"; do
    container_id="$(
      docker ps -aq \
        --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}" \
        --filter "label=com.docker.compose.service=${service}" \
        | head -n 1
    )"
    if [[ -z "$container_id" ]]; then
      log "$service is new in the target release; rollback will remove it if deployment fails."
      jq -n --arg service "$service" '$service' >>"$temp_absent"
      continue
    fi

    image_id="$(docker inspect --format '{{.Image}}' "$container_id")"
    [[ -n "$image_id" ]] || continue

    tag="velora-rollback/${service}:${DEPLOY_ID}"
    docker image tag "$image_id" "$tag"
    jq -n --arg service "$service" --arg image "$tag" '{service:$service,image:$image}' >>"$temp_entries"
  done

  jq -s \
    --arg from_sha "$from_sha" \
    --arg to_sha "$to_sha" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --slurpfile absent "$temp_absent" \
    '{from_sha:$from_sha,to_sha:$to_sha,created_at:$created_at,services:(map({key:.service,value:.image})|from_entries),absent_services:$absent}' \
    "$temp_entries" >"$output"
  rm -f -- "$temp_entries" "$temp_absent"
  chmod 600 "$output"
}

reconcile_infrastructure() {
  local service
  for service in "${INFRA_RECONCILE_SERVICES[@]}"; do
    case "$service" in
      nginx)
        log "==> Force-recreating Nginx to refresh config bind mount..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps nginx
        ;;
      prometheus)
        log "==> Force-recreating Prometheus to refresh config bind mount..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps prometheus
        ;;
      grafana)
        log "==> Force-recreating Grafana to refresh provisioning/dashboard bind mounts..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps grafana
        ;;
      node-exporter)
        log "==> Recreating node-exporter..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps node-exporter
        ;;
      cadvisor)
        log "==> Recreating cAdvisor..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps cadvisor
        ;;
      loki)
        log "==> Force-recreating Loki to refresh logging configuration..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps loki
        ;;
      alloy)
        log "==> Force-recreating Alloy to refresh log collection configuration..."
        VELORA_IMAGE_TAG="$TARGET_SHA" docker compose up -d --force-recreate --no-deps alloy
        ;;
      *)
        fail "no infrastructure reconcile handler for $service"
        ;;
    esac
  done
}

rollback_from_snapshot() {
  local snapshot="$1"
  local restore_sha="$2"
  local override="$STATE_DIR/.rollback-override-${DEPLOY_ID}.yml"
  local -a services=()
  local -a absent_services=()

  [[ -f "$snapshot" ]] || {
    warn "rollback snapshot is missing: $snapshot"
    return 1
  }
  is_sha "$restore_sha" || {
    warn "rollback SHA is invalid: $restore_sha"
    return 1
  }

  mapfile -t services < <(snapshot_service_names "$snapshot")
  mapfile -t absent_services < <(jq -r '.absent_services[]?' "$snapshot")
  if (( ${#services[@]} == 0 && ${#absent_services[@]} == 0 )); then
    warn "rollback snapshot contains no restorable or removable services"
    return 1
  fi

  # Remove services that did not exist in the healthy release while the target
  # Compose model still knows their definitions. This prevents orphan Loki/Alloy
  # containers from surviving a failed first deployment.
  if (( ${#absent_services[@]} > 0 )); then
    log "==> Removing target-only services before rollback: ${absent_services[*]}"
    VELORA_IMAGE_TAG="$TARGET_SHA" docker compose rm -sf "${absent_services[@]}" || return 1
  fi

  if (( ${#services[@]} > 0 )); then
    write_rollback_override "$snapshot" "$override"
  fi
  checkout_release "$restore_sha"

  if (( ${#services[@]} > 0 )); then
    log "==> Restoring exact pre-deploy images..."
    if contains "api-gateway" "${services[@]}"; then
      VELORA_IMAGE_TAG="$restore_sha" docker compose -f docker-compose.yml -f "$override" \
        up -d --force-recreate --no-deps --scale api-gateway=2 "${services[@]}"
    else
      VELORA_IMAGE_TAG="$restore_sha" docker compose -f docker-compose.yml -f "$override" \
        up -d --force-recreate --no-deps "${services[@]}"
    fi
    rm -f -- "$override"
  fi

  verify_deployment_health
}

main "$@"
