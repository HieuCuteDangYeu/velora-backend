# Operator-only file. Copy to a remote, untracked env file and replace every
# secret before running: docker compose --profile langfuse up -d.
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4
LANGFUSE_EXTERNAL_NETWORK=microservices-boilerplate_microservices-net
LANGFUSE_WEB_BIND=127.0.0.1
LANGFUSE_WEB_PORT=3030
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3030
LANGFUSE_NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_SALT=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=us-east-1
LANGFUSE_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
LANGFUSE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
LANGFUSE_S3_EXTERNAL_ENDPOINT=http://127.0.0.1:9090
LANGFUSE_MINIO_BIND=127.0.0.1
LANGFUSE_MINIO_PORT=9090
LANGFUSE_MINIO_CONSOLE_BIND=127.0.0.1
LANGFUSE_MINIO_CONSOLE_PORT=9091
LANGFUSE_INIT_ORG_NAME=Velora
LANGFUSE_INIT_PROJECT_ID=velora-rag
LANGFUSE_INIT_PROJECT_NAME=Velora RAG
LANGFUSE_INIT_USER_EMAIL=operator@example.invalid
LANGFUSE_INIT_USER_NAME=Velora Operator
LANGFUSE_INIT_USER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
