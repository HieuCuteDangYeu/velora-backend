l=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1899" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Successful registration followed by an optional later code submission; confirmation reads then deletes the code." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1899" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;Logical RPC arrows show the caller awaiting a correlated RabbitMQ response; transport envelopes are abstracted.&lt;br&gt;Registration success scope; failure compensation is intentionally outside this successful view (register.use-case.ts:43-67). Mail enqueue is not email-delivery proof.&lt;br&gt;Confirmation GET then DELETE is not atomic consumeUserId; verify_user failure does not reach DELETE." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="1991" width="1899" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="18-auth-login" name="18 · Login and session restoration"><mxGraphModel page="0" pageWidth="1955" pageHeight="2527" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;18-auth-login&quot;,&quot;title&quot;:&quot;18 \u00b7 Login and session restoration&quot;,&quot;subtitle&quot;:&quot;Password login; a separate optional cold-start hydration restores on