generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/content-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CONTENT_DATABASE_URL")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReelMediaStatus {
  PENDING
  PROBING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReelIndexStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  DEGRADED
  FAILED
}

enum ReelSourceOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum ReelSourceLengthClass {
  SHORT
  LONG
}

enum ReelViewEventType {
  IMPRESSION
  WATCH_START
  WATCH_PROGRESS
  WATCH_END
  SKIP
  COMPLETE
  REPLAY
  PAUSE
  RESUME
  MUTE
  UNMUTE
}

enum ReelEventSource {
  RECOMMENDED
  FRIENDS
  PUBLIC_FEED
  PROFILE
  SEARCH
  SHARED
  DIRECT
  UNKNOWN
}

model Reel {
  id                            String           @id @default(uuid())
  userId                        String
  mediaKey                      String
  title                         String?
  description                   String?
  tags                          String[]
  status                        ProcessingStatus @default(PENDING)
  mediaStatus                   ReelMediaStatus  @default(PENDING)
  indexStatus                   ReelIndexStatus  @default(NOT_REQUESTED)
  visibility                    String           @default("public")
  viewCount                     BigInt           @default(0)
  transcript                    String?          @db.Text
  transcriptVtt                 String?          @db.Text
  transcriptSegments            Json?
  thumbnailKey                  String?
  hlsMasterKey                  String?
  transcriptionAudioManifestKey String?
  mediaOutput                   Json?
  mediaEdit                     Json?
  outputDurationMs              Int?
  processingStage               String?
  processingMessage             String?          @db.Text
  processingProgress            Int?
  processingAttemptId           String?
  processingStartedAt           DateTime?
  processingFailedAt            DateTime?
  processingCompletedAt         DateTime?
  processingErrorCode           String?
  processingErrorDetail         String?          @db.Text
  mediaAttemptId                String?
  indexAttemptId                String?
  indexVersion                  String?
  indexCompletedAt              DateTime?
  indexDocumentCount            Int?
  indexSectionCount             Int?
  indexChunkCount               Int?
  indexEmbeddingProvider        String?
  indexEmbeddingModel           String?
  indexEmbeddingDimensions      Int?
  indexEmbeddingVersion         String?

  sourceDurationMs      Int?
  sourceWidth           Int?
  sourceHeight          Int?
  sourceFps             Float?
  sourceBitrateKbps     Int?
  sourceHasAudio        Boolean?
  sourceRotation        Int?
  sourceOrientation     ReelSourceOrientation?
  sourceLengthClass     ReelSourceLengthClass?
  sourceAspectRatio     Float?
  sourceEffectiveWidth  Int?
  sourceEffectiveHeight Int?
  encodedVariantCount   Int?
  encodedMaxHeight      Int?
  encodedFps            Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares       ReelShare[]
  shareLinks   ReelShareLink[]
  viewEvents   ReelViewEvent[]
  viewSessions ReelViewSession[]

  @@index([userId])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([userId, visibility, createdAt(sort: Desc)])
  @@index([status])
  @@index([mediaStatus])
  @@index([indexStatus])
  @@index([mediaStatus, visibility, createdAt(sort: Desc)])
  @@index([processingAttemptId])
  @@index([mediaAttemptId])
  @@index([indexAttemptId])
  @@index([indexVersion])
  @@index([status, processingStartedAt])
  @@index([status, visibility, createdAt(sort: Desc)])
}

model ReelShare {
  id               String   @id @default(uuid())
  reelId           String
  ownerId          String
  sharedByUserId   String
  sharedWithUserId String?
  conversationId   String
  messageId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([ownerId])
  @@index([sharedByUserId])
  @@index([sharedWithUserId])
  @@index([conversationId])
  @@index([messageId])
}

model ReelShareLink {
  id         String    @id @default(uuid())
  reelId     String
  ownerId    String
  token      String    @unique
  createdBy  String
  expiresAt  DateTime?
  revokedAt  DateTime?
  clickCount BigInt    @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([ownerId])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ReelViewEvent {
  eventId                   String            @id
  reelId                    String
  userId                    String
  playbackSessionId         String
  sequence                  Int
  eventType                 ReelViewEventType
  source                    ReelEventSource   @default(UNKNOWN)
  watchMs                   Int               @default(0)
  durationMs                Int?
  percentageWatched         Float?
  muted                     Boolean?
  completed                 Boolean           @default(false)
  replayed                  Boolean           @default(false)
  skipped                   Boolean           @default(false)
  recommendationId          String?
  feedSessionId             String?
  algorithmVersion          String?
  candidateSource           String?
  rank                      Int?
  recommendationGeneratedAt DateTime?
  occurredAt                DateTime
  receivedAt                DateTime          @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId, playbackSessionId, sequence])
  @@index([reelId, occurredAt])
  @@index([userId, occurredAt])
  @@index([userId, reelId, occurredAt])
  @@index([userId, playbackSessionId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([source, occurredAt])
  @@index([feedSessionId])
  @@index([recommendationId])
  @@index([receivedAt])
}

model ReelViewSession {
  userId            String
  reelId            String
  playbackSessionId String
  startedAt         DateTime
  createdAt         DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([userId, reelId, playbackSessionId])
  @@index([reelId, startedAt])
  @@index([userId, startedAt])
  @@index([createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimToken    String?
  claimedAt     DateTime?
  lastError     String?   @db.Text

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([claimToken, claimedAt])
  @@index([aggregateType, aggregateId])
}
