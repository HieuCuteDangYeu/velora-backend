;spacingLeft=10;fillColor=#EAF3FF;swimlaneFillColor=#ffffff;strokeColor=#2F80ED;childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Helvetica;fontColor=#1F2937;fontStyle=1;strokeWidth=2;rounded=1;arcSize=5;" sourceEvidence="[&quot;backend:apps/friend-service/prisma/schema.prisma:35-44&quot;]" semanticId="UserBlock" domainRole="entity" tooltip="UserBlock   friend service · PostgreSQL schema"><mxGeometry as="geometry" x="1900" y="495.0" width="440" height="128" /></mxCell><mxCell id="UserBlock_fields" value="blockerId: String&lt;br&gt;blockedUserId: String&lt;br&gt;createdAt: DateTime" vertex="1" parent="UserBlock" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=#1F2937;spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="76" /></mxCell><mxCell id="title" value="12 · Identity and social entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=24;fontStyle=1;align=left;fontColor=#1F2937;fillColor=none;"><mxGeometry as="geometry" x="35" y="17" width="2844.016" height="45" /></mxCell><mxCell id="summary-box" value="In plain words" vertex="1" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#B45309;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;"><mxGeometry as="geometry" x="35" y="72.0" width="1300" height="88" /></mxCell><mxCell id="summary-text" value="The tables behind accounts and friendships. Auth owns users, roles and refresh tokens; Friend owns friendships and blocks. Links between services use plain ids, never database foreign keys." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;align=left;verticalAlign=top;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="51.0" y="104.0" width="1268" height="50" /></mxCell><mxCell id="notes" value="User IDs and token successors are logical references. Role links declare SQL FKs.&lt;br&gt;Friendship: unique canonical user pair. UserRole: unique (userId, roleId). UserBlock: compound key." vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#1F2937;fontColor=#1F2937;"><mxGeometry as="geometry" x="35" y="975.0" width="844.7500000000001" height="62" /></mxCell><mxCell id="E01-identity-social-e4_second" value="recipient" edge="1" parent="1" source="Friendship" target="User" style="html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.75;entryX=1;entryY=0.3;" sourceEvidence="[&quot;backend:apps/friend-service/prisma/schema.prisma:17-44&quot;]" relationKind="association" enforcement="logical scalar ID"><mxGeometry as="geometry" relative="1" x="-0.17791450443448353" y="15.0"><Array as="points" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e4_second_multiplicity0" value="0..*" vertex="1" parent="E01-identity-social-e4_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e4_second_multiplicity1" value="1" vertex="1" parent="E01-identity-social-e4_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="1" y="0" width="15" height="20" relative="1"><mxPoint x="6.0" y="-26.0" as="offset" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e5_second" value="blocked user" edge="1" parent="1" source="UserBlock" target="User" style="html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.75;entryX=1;entryY=0.9;" sourceEvidence="[&quot;backend:apps/friend-service/prisma/schema.prisma:35-44&quot;]" relationKind="association" enforcement="logical scalar ID"><mxGeometry as="geometry" relative="1" x="0.5277084053423322" y="-15.0"><Array as="points" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e5_second_multiplicity0" value="0..*" vertex="1" parent="E01-identity-social-e5_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeometry></mxCell><mxCell id="E01-identity-social-e5_second_multiplicity1" value="1" vertex="1" parent="E01-identity-social-e5_second" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="1" y="0" width="15" height="20" relative="1"><mxPoint x="6.0" y="-26.0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="13-content" name="13 · Reel, Series and sharing entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="2495.0" pageHeight="1780.0" shadow="0" adaptiveColors="none" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. UNIQUE(seriesId,episodeNumber) orders episodes. ViewSession PK is (userId,reelId,playbackSessionId). ViewEvent UNIQUE(userId,reelId,playbackSessionId,sequence). Outbox aggregate and playback-session correlation links have no declared FK. series: seriesId; nullable; onDelete SetNull (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); reel: reelId; Cascade delete (declared SQL FK); aggregate: aggregateId when aggregateType=REEL (logical) (scalar-ID association; no declared FK); playback session: userId + reelId + playbackSessionId correlation (scalar-ID association; no declared FK) Operational upload/media-attempt lease rows are Content-owned; their publishIntentId/mediaKey and reelId/attemptId links are logical correlations, not declared Prisma FKs. ReelSubtitleTrack UNIQUE(reelId, language); reel: reelId cascade delete (declared SQL FK); sourceHash ties a track to the transcript it was translated from. ReelRerankExposure PK is (feedSessionId, reelId); its userId and reelId are logical scalar IDs joined to ReelViewEvent, not declared FKs. Reel.searchTags is a normalized copy of tags kept by a database trigger and indexed with GIN."><root><mxCell id="0" style="fontFamily=Helvetica;" value="" /><mxCell id="1" parent="0" style="fontFamily=Helvetica;" value="" /><mxCell id="E02-content-e1" value="series" edge="1" parent="1" source="Reel" target="ReelSeries" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.43199999999999983;exitY=0.9999999999999994;entryX=0.5;entryY=0.0;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:144-263&quot;]" relationKind="association" enforcement="declared relation"><mxGeometry as="geometry" relative="1" x="0.39802323941675866" y="26.0"><Array as="points"><mxPoint x="1218.0639999999999" y="1335.391" /><mxPoint x="1247.984" y="1335.391" /></Array></mxGeometry></mxCell><mxCell id="E02-content-e1_multiplicity0" value="0..*" vertex="1" parent="E02-content-e1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeometry></mxCell><mxCell id="E02-content-e1_multiplicity1" value="0..1" vertex="1" parent="E02-content-e1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="1" y="0" width="32" height="20" relative="1"><mxPoint x="6.0" y="-26.0" as="offset" /></mxGeometry></mxCell><mxCell id="E02-content-e2" value="reel" edge="1" parent="1" source="ReelShare" target="Reel" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;entryX=0.1600000000000002;entryY=0.0;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:216-301&quot;]" relationKind="association" enforcement="declared 