rds" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;rounded=1;arcSize=6;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=16;fontStyle=1;fontColor=#B45309;" sourceEvidence="[]"><mxGeometry x="130" y="85" width="1930" height="86" as="geometry" /></mxCell><mxCell id="flow3" value="Four safety checks surround one AI turn: the question before any model call, retrieved evidence before it enters the prompt, the answer while it streams, and memory before it is stored. Each check has its own mode (off, shadow or enforce) and always fails open so safety never takes chat down." vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;text;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;" sourceEvidence="[]"><mxGeometry x="146" y="117" width="1890" height="48" as="geometry" /></mxCell><mxCell id="flow4" value="Conversation Service" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;rounded=1;arcSize=14;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#34A853;strokeWidth=1.8;align=center;verticalAlign=middle;fontStyle=1;" sourceEvidence="[]" participantId="conv"><mxGeometry x="170" y="196" width="260" height="70" as="geometry" /></mxCell><mxCell id="flow5" value="AI Service" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;rounded=1;arcSize=14;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#34A853;strokeWidth=1.8;align=center;verticalAlign=middle;fontStyle=1;" sourceEvidence="[]" participantId="ai"><mxGeometry x="490" y="196" width="260" height="70" as="geometry" /></mxCell><mxCell id="flow6" value="Classifier model (optional)" vertex="1" parent="1" style="html=1;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;rounded=1;arcSize=14;dashed=1;dashPattern=6 3;whiteSpace=wrap;fillColor=#FFF5F5;strokeColor=#EF4444