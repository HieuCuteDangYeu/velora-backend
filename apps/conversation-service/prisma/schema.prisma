generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/conversation-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("CONVERSATION_DATABASE_URL")
}

type MessageReadStatus {
  userId String
  at     DateTime
}

// Định nghĩa cấu trúc cho Signal Protocol Keys
type SignedPreKey {
  keyId     Int
  publicKey String
  signature String
}

type OneTimePreKey {
  keyId     Int
  publicKey String
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConversationMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

// --- MODELS ---

model Conversation {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  creatorId      String   @map("creator_id")
  participantIds String[]

  // V1 compatibility fields. participantIds/creatorId/memberJoinedAt remain the
  // canonical membership contract during the V2 rolling migration. The
  // ConversationMember collection is introduced as a parallel projection first.
  name           String?
  picture        String?
  memberJoinedAt Json?

  // lastMessage chỉ lưu text hiển thị preview (ví dụ: "Tin nhắn mới", "[Hình ảnh]")
  // Vì nội dung thật đã bị mã hóa
  lastMessage   String?
  lastMessageAt DateTime?

  isGroup   Boolean
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  messages Message[]
  members  ConversationMember[]

  @@index([participantIds])
  @@map("conversations")
}

model ConversationMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String

  role   ConversationMemberRole   @default(MEMBER)
  status ConversationMemberStatus @default(ACTIVE)

  joinedAt  DateTime
  invitedBy String?
  leftAt    DateTime?
  removedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId, status, role])
  @@index([userId, status])
  @@map("conversation_members")
}

model Message {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  type            String  @default("text")
  clientMessageId String

  // 2. SIGNAL TYPE: Dùng cho Mã hóa (Server chỉ chuyển tiếp)
  // 1: WhisperMessage (Tin bình thường)
  // 3: PreKeyWhisperMessage (Tin thiết lập phiên X3DH)
  signalType Int @map("signal_type")

  content  String
  media    Json?
  metadata Json?

  registrationId Int? // ID thiết bị người gửi
  senderId       String
  isRecalled     Boolean   @default(false)
  recalledAt     DateTime?
  replyToId      String?   @db.ObjectId
  replyPreview   Json?
  reactions      Json?

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  createdAt DateTime            @default(now())
  readBy    MessageReadStatus[]

  // Embedded notification intent, committed with the message and preview.
  // Missing/null due dates on historical messages are deliberately not replayed.
  notificationRecipientIds  String[] @default([])
  notificationNextAttemptAt DateTime?
  notificationClaimId       String?
  notificationAttemptCount  Int @default(0)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@unique([conversationId, senderId, clientMessageId])
  @@index([replyToId])
  @@index([notificationNextAttemptAt, id], map: "messages_notification_outbox_due")
  @@map("messages")
}

// MODEL MỚI: Quản lý khóa Signal (Key Store)
model UserKeyBundle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId         String @unique // Mỗi user 1 bộ key (hoặc tách theo deviceId nếu cần)
  deviceId       Int
  registrationId Int
  identityKey    String

  // Composite Types (Nhúng trực tiếp vào document)
  signedPreKey   SignedPreKey
  oneTimePreKeys OneTimePreKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_key_bundles")
}
