ontFamily=Arial;fontSize=13;fontColor=#253849;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="1660" width="1520" height="92" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="05-dfd-auth" name="05 · D2 · Account and access"><mxGraphModel page="0" pageWidth="1520" pageHeight="1340.0" grid="1" semanticModel="{&quot;page&quot;:&quot;05&quot;,&quot;id&quot;:&quot;05-dfd-auth&quot;,&quot;title&quot;:&quot;D2 \u00b7 Account and access&quot;,&quot;type&quot;:&quot;logical-dfd&quot;,&quot;level&quot;:2,&quot;parent&quot;:&quot;1.0&quot;,&quot;source&quot;:&quot;auth&quot;,&quot;nodes&quot;:[{&quot;id&quot;:&quot;p1&quot;,&quot;label&quot;:&quot;Validate account&quot;,&quot;kind&quot;:&quot;process&quot;,&quot;number&quot;:&quot;1.1&quot;,&quot;canonicalId&quot;:&quot;P1.1&quot;,&quot;evidence&quot;:[&quot;backend:apps/api-gateway/src/auth/guards/jwt-auth.guard.ts:1-60&quot;,&quot;backend:apps/auth-service/prisma/schema.prisma:1-45&quot;,&quot;backend:apps/auth-service/src/application/use-cases/login.use-case.ts:1-79&quot;,&quot;backend:apps/auth-service/src/application/use-cases/logout.use-case.ts:1-33&quot;,&quot;backend:apps/auth-service/src/application/use-cases/refresh-token.use-case.ts:1-187&quot;,&quot;backend:apps/auth-service/src/application/use-cases/verify-google-token.use-case.ts:16-63&quot;,&quot;backend:apps/auth-service/src/infrastructure/repositories/redis-user-role.repository.ts:1-21&quot;,&quot;backend:apps/user-service/src/application/use-cases/update-user.use-case.ts:26-90&quot;,&quot;mobile:app/(auth)/login.tsx:1-330&quot;,&quot;mobile:app/(auth)/login.tsx:51-100&quot;,&quot;mobile:src/api/auth.api.ts:1-136&quot;],&quot;ownerComposition&quot;:[&quot;Mobile&quot;,&quot;Auth&quot;,&quot;User&quot;,&quot;Mail&quot;],&quot;duplicate&quot;:false},{&quot;id&quot;:&quot;u1&quot;,&quot;label&quot;:&quot;User *&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;number&quot;:null,&quot;canonica