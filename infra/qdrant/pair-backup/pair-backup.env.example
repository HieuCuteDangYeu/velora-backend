# Copy to a private location (mode 600) and fill in. No secrets belong in this file: it names
# paths and containers only. Credentials stay in ENV_FILE and SECRETS_DIR.
# REPO_DIR holds scripts/ops and infra/qdrant; OPS_IMAGE is the `builder` stage image (README.md).
REPO_DIR=/Users/quan/velora-operations/pair-backup/repo
OPS_IMAGE=velora-reel-qdrant-ops:6ca1491e
# Only the listed keys are copied from ENV_FILE into the operator container.
ENV_FILE=/Users/quan/GitHub/microservices-boilerplate/.env
# api-key, ca.crt, backup-key: keep outside the repo and outside the R2 prefix.
SECRETS_DIR=/Users/quan/velora-operations/qdrant-secrets
# mode 700
WORK_DIR=/Users/quan/velora-operations/pair-backup/work
PG_CONTAINER=microservices-boilerplate-reel-indexing-postgres-1
PG_USER=reel_indexing_admin
PG_DB=reel_indexing
INDEXER_CONTAINERS="microservices-boilerplate-reel-indexing-service-1 microservices-boilerplate-reel-indexing-long-service-1"
NET_SQL=microservices-boilerplate_microservices-net
NET_VECTOR=microservices-boilerplate_reel-vector-net
# NOT the prefix of the older flat Qdrant archives: the 7-archive rotation there must not
# see these.
R2_PREFIX=velora-private-backups/reel-indexing-pairs
# Second off-site copy (ciphertext only, verified by sha256). Leave empty until a key-based
# login to velora-node-2 exists.
OFFSITE_SSH=
OFFSITE_DIR=/opt/velora/backups-indexing
