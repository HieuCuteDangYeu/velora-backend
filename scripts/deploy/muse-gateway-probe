#!/usr/bin/env bash
set -uo pipefail

# Runs on the homelab every 60 s (LaunchAgent com.velora.muse-gateway-probe). Checks the Muse gateway (muse2api) on the
# laptop through its reverse SSH tunnel and reports through node-exporter's text-file collector, like model-host-probe.
# It reads the gateway's unauthenticated /readyz, which needs no key and starts no model call. /readyz turns not-ready
# when the muse.ai login session is rejected (the gateway's keepalive runs every 10 minutes), so an expired session is
# noticed within about ten minutes. Install the probe only when AI_MUSE_ENABLED is on: with Muse off there is nothing to alert on.
#
#   velora_muse_gateway_up                  1 if /readyz answered 200 through the tunnel
#   velora_muse_gateway_ready               1 if the gateway reports ready (a usable muse.ai session)
#   velora_muse_gateway_accounts_available  usable muse.ai sessions
#   velora_muse_gateway_accounts_invalid    sessions the gateway has marked rejected
#   velora_muse_gateway_probe_timestamp_seconds  when this probe ran, to detect a stopped probe

PORT="${MUSE_GATEWAY_TUNNEL_PORT:-18611}"
TIMEOUT="${MUSE_GATEWAY_PROBE_TIMEOUT_SECONDS:-5}"
APP_DIR="${VELORA_APP_DIR:-$HOME/GitHub/microservices-boilerplate}"
OUT_DIR="${VELORA_MODEL_HOST_METRICS_DIR:-$APP_DIR/infra/monitoring/node-exporter-textfile}"
OUT="$OUT_DIR/velora-muse-gateway.prom"

[[ "$PORT" =~ ^[0-9]+$ && "$TIMEOUT" =~ ^[0-9]+$ ]] || exit 0
[[ -d "$OUT_DIR" ]] || exit 0

body="$(curl -s -m "$TIMEOUT" -w '\n%{http_code}' "http://127.0.0.1:${PORT}/readyz" 2>/dev/null || true)"
code="${body##*$'\n'}"
body="${body%$'\n'*}"

up=0 ready=0 available=0 invalid=0
if [[ "$code" == 200 ]]; then
  up=1
  [[ "$body" == *'"ready":true'* ]] && ready=1
  if [[ "$body" =~ \"available\":([0-9]+) ]]; then available="${BASH_REMATCH[1]}"; fi
  if [[ "$body" =~ \"invalid\":([0-9]+) ]]; then invalid="${BASH_REMATCH[1]}"; fi
fi

tmp="$(mktemp "$OUT.XXXXXX")" || exit 0
{
  printf '# HELP velora_muse_gateway_up Whether the Muse gateway on the laptop answered through the tunnel.\n'
  printf '# TYPE velora_muse_gateway_up gauge\n'
  printf 'velora_muse_gateway_up %s\n' "$up"
  printf '# HELP velora_muse_gateway_ready Whether the gateway reports a usable muse.ai session.\n'
  printf '# TYPE velora_muse_gateway_ready gauge\n'
  printf 'velora_muse_gateway_ready %s\n' "$ready"
  printf '# HELP velora_muse_gateway_accounts_available Usable muse.ai sessions.\n'
  printf '# TYPE velora_muse_gateway_accounts_available gauge\n'
  printf 'velora_muse_gateway_accounts_available %s\n' "$available"
  printf '# HELP velora_muse_gateway_accounts_invalid muse.ai sessions the gateway marked as rejected.\n'
  printf '# TYPE velora_muse_gateway_accounts_invalid gauge\n'
  printf 'velora_muse_gateway_accounts_invalid %s\n' "$invalid"
  printf '# HELP velora_muse_gateway_probe_timestamp_seconds Unix time of the last probe.\n'
  printf '# TYPE velora_muse_gateway_probe_timestamp_seconds gauge\n'
  printf 'velora_muse_gateway_probe_timestamp_seconds %s\n' "$(date +%s)"
} >"$tmp"
# mktemp creates 0600; the node-exporter container reads the directory as another user.
chmod 0644 "$tmp"
mv -f "$tmp" "$OUT"
