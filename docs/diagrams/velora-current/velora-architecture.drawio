" parent="ReelShareLink" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=#1F2937;spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="116" /></mxCell><mxCell id="ReelViewEvent" value="&lt;b&gt;ReelViewEvent&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;startSize=52;fontSize=16;spacingLeft=10;fillColor=#FFF7E6;swimlaneFillColor=#ffffff;strokeColor=#F59E0B;childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Helvetica;fontColor=#1F2937;fontStyle=1;strokeWidth=2;rounded=1;arcSize=5;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:258-348&quot;]" semanticId="ReelViewEvent" domainRole="entity" tooltip="ReelViewEvent   content service · PostgreSQL schema"><mxGeometry as="geometry" x="1196.9679999999998" y="272.956" width="440" height="188" /></mxCell><mxCell id="ReelViewEvent_fields" value="eventId: String {PK}&lt;br&gt;reelId: String&lt;br&gt;userId: String&lt;br&gt;playbackSessionId: String&lt;br&gt;sequence: Int&lt;br&gt;eventType: ReelViewEventType" vertex="1" parent="ReelViewEvent" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=#1F2937;spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="136" /></mxCell><mxCell id="ReelViewSession" value="&lt;b&gt;ReelViewSession&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;startSize=52;fontSize=16;spacingLeft=10;fillColor=#FFF7E6;swimlaneFillColor=#ffffff;strokeColor=#F59E0B;childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Helvetica;fontColor=#1F2937;fontStyle=1;strokeWidth=2;rounded=1;arcSize=5;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:296-348&quot;]" semanticId="ReelViewSession" domainRole="entity" tooltip="ReelViewSession   content service · PostgreSQL schema"><mxGeometry as="geometry" x="1367.0320000000002" y="688.012" width="440" height="128" /></mxCell><mxCell id="ReelViewSession_fields" value="userId: String&lt;br&gt;reelId: String&lt;br&gt;playbackSessionId: String" vertex="1" parent="ReelViewSession" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=#1F2937;spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="76" /></mxCell><mxCell id="OutboxEvent" value="&lt;b&gt;OutboxEvent&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;startSize=52;fontSize=16;spacingLeft=10;fillColor=#FFF7E6;swimlaneFillColor=#ffffff;strokeColor=#F59E0B;childLayout=stackLayout;horizontal=1;resizeParent=0;resizeLast=0;collapsible=0;fontFamily=Helvetica;fontColor=#1F2937;fontStyle=1;strokeWidth=2;rounded=1;arcSize=5;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:311-348&quot;]" semanticId="OutboxEvent" domainRole="entity" tooltip="OutboxEvent   content service · PostgreSQL schema"><mxGeometry as="geometry" x="1886.008" y="658.012" width="440" height="188" /></mxCell><mxCell id="OutboxEvent_fields" value="id: String {PK}&lt;br&gt;aggregateType: String&lt;br&gt;aggregateId: String&lt;br&gt;eventType: String&lt;br&gt;claimToken: String [0..1]&lt;br&gt;publishedAt: DateTime [0..1]" vertex="1" parent="OutboxEvent" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;strokeColor=none;fillColor=none;fontColor=#1F2937;spacingTop=8;spacingBottom=8;"><mxGeometry as="geometry" x="0" y="52" width="440" height="136" /></mxCell><mxCell id="title" value="13 · Reel, Series and sharing entities" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=24;fontStyle=1;align=left;fontColor=#1F2937;fillColor=none;"><mxGeometry as="geometry" x="35" y="17" width="2425.968" height="45" /></mxCell><mxCell id="summary-box" value="In plain words" vertex="1" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#B45309;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;"><mxGeometry as="geometry" x="35" y="72.0" width="1300" height="88" /></mxCell><mxCell id="summary-text" value="The tables behind Reels. A Reel belongs optionally to a Series and can have shares, share links, view events, subtitle tracks and outbox events. Upload and media leases protect publishing; rerank exposure rows measure the feed experiment." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;align=left;verticalAlign=top;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="51.0" y="104.0" width="1268" height="50" /></mxCell><mxCell id="notes" value="UNIQUE(userId, publishIntentId): one logical Reel per owner / publish action.&lt;br&gt;Fingerprint rejects conflicting intent reuse; different intent permits the same source video.&lt;br&gt;Upload adoption uses owner + publishIntentId + mediaKey. Attempt leases correlate by reelId / attemptId.&lt;br&gt;These lease correlations are logical scalar IDs, not declared foreign keys.&lt;br&gt;Series deletion sets the optional Reel link to null; declared Reel references cascade. Outbox/session links are logical.&lt;br&gt;Subtitle tracks cascade with their Reel. Rerank exposure rows are experiment measurements keyed by feed session and Reel; they are not part of the Reel aggregate." vertex="1" parent="1" style="shape=note;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#1F2937;fontColor=#1F2937;"><mxGeometry as="geometry" x="35" y="1963.0" width="1450" height="190" /></mxCell><mxCell id="ReelUploadLease" value="&lt;b&gt;ReelUploadLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=#ffffff;strokeColor=#1F2937;fontColor=#1F2937;fontFamily=Helvetica;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:170-199&quot;]"><mxGeometry x="35" y="1653.0" width="440" height="252" as="geometry" /></mxCell><mxCell id="ReelUploadLease_fields" value="id: String {PK}&lt;br&gt;userId: String&lt;br&gt;publishIntentId: String&lt;br&gt;mediaKey: String&lt;br&gt;fileType: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;adoptedAt: DateTime [0..1]&lt;br&gt;cancelledAt: DateTime [0..1]&lt;br&gt;cleanupClaimedAt: DateTime [0..1]&lt;br&gt;cleanupCompletedAt: DateTime [0..1]" vertex="1" parent="ReelUploadLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="200" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease" value="&lt;b&gt;ReelMediaAttemptLease&lt;/b&gt;&lt;br&gt;Content" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;rounded=0;fillColor=#ffffff;strokeColor=#1F2937;fontColor=#1F2937;fontFamily=Helvetica;fontSize=15;" sourceEvidence="[&quot;backend:apps/content-service/prisma/schema.prisma:170-199&quot;]"><mxGeometry x="550" y="1653.0" width="440" height="148" as="geometry" /></mxCell><mxCell id="ReelMediaAttemptLease_fields" value="attemptId: String {PK}&lt;br&gt;reelId: String&lt;br&gt;expiresAt: DateTime&lt;br&gt;completedAt: DateTime [0..1]" vertex="1" parent="ReelMediaAttemptLease" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;fillColor=none;strokeColor=none;"><mxGeometry x="0" y="52" width="440" height="96" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="14-semantic-hierarchy" name="14 · Semantic evidence entities"><mxGraphModel grid="0" gridSize="10" page="0" pageWidth="1469.0" pageHeight="1700.0" shadow="0" adaptiveColors="none" scopeDescription="Implemented entities and conceptual associations; database enforcement is stated in the constraint note." schemaConstraints="UML entity model: solid lines are associations; multiplicities describe the named roles, not database integrity. Attributes use [0..1] for optional values and [0..*] for lists. {PK}/{UQ} are schema-key constraints. Enforced relations and scalar-ID mappings are listed below; cross-service IDs are not foreign keys. {xor}: each chunk has either a section parent or a document parent; both links require the same indexAttemptId. Chunk has one parent selected by strategy: section OR document. The two optional parent links are alternatives, not simultaneous parents. Semantic tables use rowId PK and UNIQUE(id,indexAttemptId). Historical candidates can exist; retrieval serves accepted active rows.  Migrations declare partial uniqueness for active rows: at most one active ReelDocument per Reel, and one active section/chunk/scene per stable id. Live migration application is not probed. reel: reelId: cross-service reference (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); document: parentId = reelDocumentId, same attempt (scalar-ID association; no declared FK); section parent: long-form chunk: parentId = sectionId (scalar-ID association; no declared FK); document parent: short/document chunk: parentId = reelDocumentId (scalar-ID association; no declared FK)"><root><mxCell id="0" style="fontFamily=Helvetica;" value="" /><mxCell id="1" parent="0" style="fontFamily=Helvetica;" value="" /><mxCell id="E03-semantic-hierarchy-e1" value="reel" edge="1" parent="1" source="ReelDocument" target="Reel" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=0;exitX=0.38666666666666666;exitY=1.0;entryX=0.5;entryY=0.0;endArrow=none;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;whiteSpace=nowrap;spacing=0;align=center;verticalAlign=middle;" sourceEvidence="[&quot;backend:apps/reel-indexing-service/prisma/schema.prisma:153-238&quot;]" relationKind="association" enforcement="logical scalar ID"><mxGeometry as="geometry" relative="1" x="0.44666324604999774" y="18.5"><Array as="points"><mxPoint x="510.1357333333333" y="1231.385" /><mxPoint x="560.0024" y="1231.385" /></Array></mxGeometry></mxCell><mxCell id="E03-semantic-hierarchy-e1_multiplicity0" value="0..*" vertex="1" parent="E03-semantic-hierarchy-e1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="-1" y="0" width="29" height="20" relative="1"><mxPoint x="6.0" y="6.0" as="offset" /></mxGeometry></mxCell><mxCell id="E03-semantic-hierarchy-e1_multiplicity1" value="1" vertex="1" parent="E03-semantic-hierarchy-e1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontColor=#1F2937;fillColor=none;spacing=0;"><mxGeometry as="geometry" x="1" y="0" width="15" height="20" relative="1"><mxPoint x="6.0" y="-26.0" as="offset" /></mxGeometry></mxCell><mxCell id="E03-semantic-hierarchy-e2" value="document" edge="1" parent="1" source="ReelSection" target="ReelDocument" style="edgeStyle=none;noEdgeStyle=1;html=1;strokeColor=#475569;strokeWidth=1.6;jumpStyle=arc;jumpSize=12;exitPerimeter=0;entryPerimeter=