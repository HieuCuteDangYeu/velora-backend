a-processing-service/src/application/use-cases/prepare-reel-media.use-case.ts:1-689&quot;,&quot;backend:apps/reel-indexing-service/prisma/schema.prisma:1-450&quot;,&quot;backend:apps/reel-indexing-service/src/application/use-cases/build-hierarchical-index.use-case.ts:1-630&quot;,&quot;backend:apps/reel-indexing-service/src/application/use-cases/commit-semantic-candidate.use-case.ts:1-74&quot;,&quot;backend:apps/reel-indexing-service/src/application/use-cases/transcribe-audio-manifest.use-case.ts:1-201&quot;,&quot;backend:apps/reel-indexing-service/src/infrastructure/workflows/reel-index-langgraph.workflow.ts:1-1023&quot;]}],&quot;layout&quot;:&quot;chain&quot;,&quot;recordFamilies&quot;:{&quot;D1&quot;:&quot;Account and social records&quot;,&quot;D2&quot;:&quot;Reel / Series / sharing records&quot;,&quot;D3&quot;:&quot;Media and semantic evidence&quot;,&quot;D4&quot;:&quot;Conversation and memory records&quot;,&quot;D5&quot;:&quot;Discovery and feed records&quot;},&quot;recordOwners&quot;:{&quot;D1&quot;:[&quot;Auth&quot;,&quot;User&quot;,&quot;Friend&quot;],&quot;D2&quot;:[&quot;Content&quot;],&quot;D3&quot;:[&quot;Media/R2&quot;,&quot;Media Processing&quot;,&quot;Reel Indexing&quot;,&quot;Mobile media cache&quot;],&quot;D4&quot;:[&quot;Conversation/Mongo&quot;,&quot;AI/PostgreSQL&quot;],&quot;D5&quot;:[&quot;Content playback records&quot;,&quot;Content feed/cache records&quot;]},&quot;scope&quot;:&quot;Payment, call, notification and ordinary conversation excluded; AI and Reel-sharing retained.&quot;,&quot;note&quot;:&quot;Media completion and evidence/indexing are separate Content-owned stages: SOURCE_VIDEO persists validated HLS/thumbnail and queues an evidence job; EXISTING_HLS evidence preserves source metadata before indexing. Inactive candidates and accepted evidence remain distinct datasets; checkpoint, resume, activation and rollback are sequences 29–31.&quot;,&quot;requestEnvelope&quot;:&quot;Authenticated actor/viewer and operation-specific Reel/conversation/target/session IDs are part of request datasets; public-link requests use token context.&quot;,&quot;layoutBoxes&quot;:{&quot;p1&quot;:[280,390,240,110],&quot;p2&quot;:[630,390,240,110],&quot;p3&quot;:[980,390,240,110],&quot;input&quot;:[10,395,180,100],&quot;artifacts&quot;:[260,700,280,90],&quot;models1&quot;:[265,145,270,85],&quot;models2&quot;:[615,145,270,85],&quot;draft&quot;:[610,700,280,90],&quot;existing&quot;:[960,700,280,90],&quot;reel&quot;:[960,145,280,90]},&quot;layoutRoutes&quot;:{&quot;09-dfd-index-f1&quot;:[[190,445.0],[280,445.0]],&quot;09-dfd-index-f2&quot;:[[520,445.0],[630,445.0]],&quot;09-dfd-index-f3&quot;:[[870,445.0],[980,445.0]],&quot;09-dfd-index-f4&quot;:[[400.0,700],[400.0,500]],&quot;09-dfd-index-f5&quot;:[[350.0,390],[350.0,230]],&quot;09-dfd-index-f6&quot;:[[450.0,230],[450.0,390]],&quot;09-dfd-index-f7&quot;:[[700.0,390],[700.0,230]],&quot;09-dfd-index-f8&quot;:[[800.0,230],[800.0,390]],&quot;09-dfd-index-f9&quot;:[[750.0,500],[750.0,700]],&quot;09-dfd-index-f10&quot;:[[1050.0,700],[1050.0,500]],&quot;09-dfd-index-f11&quot;:[[1150.0,500],[1150.0,700]],&quot;09-dfd-index-f12&quot;:[[1150.0,235],[1150.0,390]],&quot;09-dfd-index-f13&quot;:[[1050.0,390],[1050.0,235]]},&quot;layoutLabels&quot;:{&quot;09-dfd-index-f1&quot;:[197.15,423.0,75.7,44],&quot;09-dfd-index-f2&quot;:[537.15,423.0,75.7,44],&quot;09-dfd-index-f3&quot;:[887.15,423.0,75.7,44],&quot;09-dfd-index-f12&quot;:[1079.3,299.5,141.4,26],&quot;09-dfd-index-f13&quot;:[986.6,337.0,126.8,44],&quot;09-dfd-index-f5&quot;:[286.6,297.0,126.8,26],&quot;09-dfd-index-f6&quot;:[379.3,249.0,141.4,26],&quot;09-dfd-index-f7&quot;:[643.9,288.0,112.2,44],&quot;09-dfd-index-f8&quot;:[806.0,279.0,83.0,62],&quot;09-dfd-index-f4&quot;:[343.9,578.0,112.2,44],&quot;09-dfd-index-f9&quot;:[679.3,587.0,141.4,26],&quot;09-dfd-index-f10&quot;:[1004.85,569.0,90.3,62],&quot;09-dfd-index-f11&quot;:[1115.8,578.0,68.4,44]},&quot;parentFlowMap&quot;:[{&quot;childFlow&quot;:&quot;09-dfd-index-f1&quot;,&quot;