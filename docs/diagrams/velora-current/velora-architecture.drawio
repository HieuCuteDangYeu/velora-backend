eSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=27;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="20" width="1899" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Detached refill overlaps foreground; terminal page waits before replying through Gateway." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=15;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="68" width="1899" height="62" as="geometry" /></mxCell><mxCell id="legend" value="SEQUENCE · filled arrow: synchronous call · open arrow: asynchronous message · dashed arrow: reply.&lt;br&gt;Orange: client/provider · navy: component/service · green: data/cache. Fragments use source predicates; ref expands a subordinate interaction.&lt;br&gt;The 10-second deadline is checked around awaits; it does not cap an individual awaited refill.&lt;br&gt;Foreground HTTP reply lies inside its parallel operand and does not wait for background completion unless the terminal guard requires it.&lt;br&gt;Refill failure logs in the detached path; terminal failures propagate. Semantic candidate failure is a scoped fallback, not a DB-only ranking step." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=2;fontSize=13;fontColor=#12263a;fillColor=#ffffff;;fontFamily=Arial;"><mxGeometry x="28" y="5076" width="1899" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="33-cache-invalidation" name="33 · Versioned Reel cache invalidation versus stale fill"><mxGraphModel page="0" pageWidth="1160" pageHeight="1874" grid="1" gridSize="10" adaptiveColors="auto" semanticModel="{&quot;id&quot;:&quot;33-cache-invalidation&quot;,&quot;title&quot;:&quot;33 \u00b7 Versioned Reel cache invalidation versus stale fill&quot;,&quot;subtitle&quot;:&quot;One invalidation-before-fill interleav