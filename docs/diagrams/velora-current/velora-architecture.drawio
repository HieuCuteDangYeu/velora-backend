t an integrity guarantee.&lt;br&gt;Solid Mongo associations are ORM relations, not SQL foreign-key constraints. ConversationMember is a parallel membership projection; participantIds remains a canonical contract.&lt;br&gt;User IDs refer to User Service. No RagTrace entity exists in the current local AI schema; Langfuse holds monitoring snapshots.&lt;br&gt;Dashed-link multiplicities are intended or possible associations; a stored ID does not guarantee the target exists." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;fontColor=#687782;fontFamily=Arial;"><mxGeometry as="geometry" x="35" y="1149.976" width="2425.968" height="135" /></mxCell></root></mxGraphModel></diagram><diagram id="17-auth-register" name="17 · Registration and account verification"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1675" pageHeight="1311" math="0" shadow="0"><root><mxCell id="0" style="fontFamily=Arial;" value="" /><mxCell id="1" parent="0" style="fontFamily=Arial;" value="" /><mxCell id="mobile" value="Velora-Mobile" vertex="1" parent="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f0ad64;strokeColor=#f0ad64;fontSize=15;fontStyle=1;fontFamily=Arial;fontColor=#253849;fontFamily=Arial;" sourceEvidence="[&quot;mobile:package.json:1-130&quot;]" semanticId="mobile"><mxGeometry x="8" y="135" width="184" height="70" as="geometry" /></mxCell><mxCell id="mobile_lifeline" value="" edge="1" parent="1" style="dashed=1;dashPattern=4 4;endArrow=none;strokeColor=#687782;fontFamily=Arial;"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="205" as="sourcePoint" /><mxPoint x="100" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="api_gateway" value="api-gateway" vertex="1" parent="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#315875;strokeColor=#315875;fontSize=15;fontStyle=1;fontFamily=A