#!/usr/bin/env bash
set -Eeuo pipefail

# Stable production launcher. This file is intentionally small and should be
# installed at /usr/local/bin/velora-deploy. The mutable deployment controller
# is always loaded from the CI-approved homelab-deploy commit instead of being
# copied permanently into /usr/local/bin.
resolve_default_app_dir() {
  local user_home="${HOME:-/home/quan}"
  local candidate

  for candidate in \
    "$user_home/apps/microservices-boilerplate" \
    "$user_home/GitHub/microservices-boilerplate"; do
    if [[ -d "$candidate/.git" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  printf '%s\n' "$user_home/apps/microservices-boilerplate"
}

readonly APP_DIR="${VELORA_APP_DIR:-$(resolve_default_app_dir)}"
readonly REMOTE="${VELORA_DEPLOY_REMOTE:-origin}"
readonly CONTROLLER_PATH="scripts/deploy/velora-deploy"
readonly CORE_PATH="scripts/deploy/velora-deploy-core"
readonly STATE_DIR="${VELORA_STATE_DIR:-${HOME:-/home/quan}/.local/state/velora}"
readonly DEPLOYMENT_METRICS_DIR="$APP_DIR/infra/monitoring/node-exporter-textfile"
readonly DEPLOYMENT_METRICS_FILE="$DEPLOYMENT_METRICS_DIR/velora-deploy.prom"

export VELORA_APP_DIR="$APP_DIR"
export VELORA_STATE_DIR="$STATE_DIR"

umask 077

deployment_log_action() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    printf 'Run sudo launchctl print system/com.velora.deploy and tail -n 100 "$HOME/Library/Logs/Velora/deploy.err.log".'
  else
    printf 'Run systemctl status velora-deploy.service and journalctl -u velora-deploy.service -n 100 --no-pager.'
  fi
}

publish_launcher_failure() {
  local reason="$1"
  local action="$(deployment_log_action) Restore Git connectivity or the approved controller, then wait for the timer or rerun velora-deploy."
  local target_sha deployed_sha pending_since tmp_file
  [[ -d "$APP_DIR" ]] || return 0

  target_sha="$(git -C "$APP_DIR" rev-parse "refs/remotes/$REMOTE/homelab-deploy" 2>/dev/null || true)"
  target_sha="${target_sha:-unknown}"
  deployed_sha="$(cat "$STATE_DIR/deployed-sha" 2>/dev/null || true)"
  deployed_sha="${deployed_sha:-none}"

  mkdir -p "$STATE_DIR" "$DEPLOYMENT_METRICS_DIR"
  if [[ "$(cat "$STATE_DIR/pending-sha" 2>/dev/null || true)" != "$target_sha" ]]; then
    printf '%s\n' "$target_sha" >"$STATE_DIR/pending-sha"
    date +%s >"$STATE_DIR/pending-since"
  fi
  pending_since="$(cat "$STATE_DIR/pending-since" 2>/dev/null || date +%s)"
  printf 'error\n' >"$STATE_DIR/pending-status"
  printf '%s\n' "$reason" >"$STATE_DIR/pending-reason"
  printf '%s\n' "$action" >"$STATE_DIR/pending-action"

  reason="${reason//\\/\\\\}"
  reason="${reason//\"/\\\"}"
  reason="${reason//$'\n'/\\n}"
  action="${action//\\/\\\\}"
  action="${action//\"/\\\"}"
  tmp_file="$(mktemp "$DEPLOYMENT_METRICS_FILE.XXXXXX")"
  {
    printf '# HELP velora_deployment_pending Promoted release has not reached a healthy production deployment.\n'
    printf '# TYPE velora_deployment_pending gauge\n'
    printf 'velora_deployment_pending{status="error",target_sha="%s",deployed_sha="%s",failed_service="deployment",reason="%s",action="%s"} 1\n' \
      "$target_sha" "$deployed_sha" "$reason" "$action"
    printf '# HELP velora_deployment_pending_since_seconds Unix timestamp when the current promoted release became pending.\n'
    printf '# TYPE velora_deployment_pending_since_seconds gauge\n'
    printf 'velora_deployment_pending_since_seconds %s\n' "$pending_since"
  } >"$tmp_file"
  mv -f -- "$tmp_file" "$DEPLOYMENT_METRICS_FILE"
}

fail() {
  local message="$*"
  publish_launcher_failure "$message" || true
  printf 'ERROR: %s\n' "$message" >&2
  exit 1
}

on_err() {
  local status=$?
  local line_no="$1"
  local command="${2:-unknown command}"
  trap - ERR
  publish_launcher_failure "Launcher command failed at line $line_no (exit $status)." || true
  printf 'ERROR: launcher command failed at line %s (exit %s): %s\n' "$line_no" "$status" "$command" >&2
  return "$status"
}

trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR

command -v git >/dev/null 2>&1 || fail "git is required"
[[ -d "$APP_DIR/.git" ]] || fail "Velora repository not found at $APP_DIR"

cd "$APP_DIR"

printf '==> Launcher fetching CI-approved Velora deployment controller...\n'
git fetch --no-tags "$REMOTE" \
  '+refs/heads/master:refs/remotes/'"$REMOTE"'/master' \
  '+refs/heads/homelab-deploy:refs/remotes/'"$REMOTE"'/homelab-deploy'

readonly APPROVED_REF="refs/remotes/$REMOTE/homelab-deploy"
readonly MASTER_REF="refs/remotes/$REMOTE/master"
approved_sha="$(git rev-parse --verify "${APPROVED_REF}^{commit}")"
master_sha="$(git rev-parse --verify "${MASTER_REF}^{commit}")"

[[ "$approved_sha" =~ ^[0-9a-f]{40}$ ]] || fail "invalid approved SHA: $approved_sha"
[[ "$master_sha" =~ ^[0-9a-f]{40}$ ]] || fail "invalid master SHA: $master_sha"

if ! git merge-base --is-ancestor "$approved_sha" "$master_sha"; then
  fail "approved homelab-deploy SHA $approved_sha is not an ancestor of master $master_sha"
fi

runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/velora-deploy-controller.XXXXXXXX")"
cleanup() {
  rm -rf -- "$runtime_dir"
}
trap cleanup EXIT HUP INT TERM

controller="$runtime_dir/velora-deploy"
core="$runtime_dir/velora-deploy-core"

git show "$approved_sha:$CONTROLLER_PATH" >"$controller" \
  || fail "approved release does not contain $CONTROLLER_PATH"
git show "$approved_sha:$CORE_PATH" >"$core" \
  || fail "approved release does not contain $CORE_PATH"
chmod 0700 "$controller" "$core"

bash -n "$controller" || fail "approved deployment controller failed syntax validation"
bash -n "$core" || fail "approved deployment core failed syntax validation"

printf '==> Launcher executing controller from approved SHA %s...\n' "$approved_sha"
if "$controller" "$@"; then
  exit 0
else
  status=$?
  printf 'ERROR: approved deployment controller exited with status %s\n' "$status" >&2
  exit "$status"
fi
