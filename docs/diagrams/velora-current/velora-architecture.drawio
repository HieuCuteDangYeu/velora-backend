;:[&quot;backend:apps/api-gateway/src/content/content.controller.ts:141-147&quot;]}]},{&quot;guard&quot;:&quot;fileExists&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;content&quot;,&quot;to&quot;:&quot;content&quot;,&quot;label&quot;:&quot;New reelId,mediaAttemptId,indexAttemptId,mediaJob identity&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:32-45&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;content&quot;,&quot;to&quot;:&quot;db&quot;,&quot;label&quot;:&quot;Transaction create PENDING Reel + media outbox&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:47-73&quot;,&quot;backend:apps/content-service/src/infrastructure/repositories/content.repository.ts:230-302&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;db&quot;,&quot;to&quot;:&quot;content&quot;,&quot;label&quot;:&quot;Committed Reel&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:47-73&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;content&quot;,&quot;to&quot;:&quot;content&quot;,&quot;label&quot;:&quot;Trigger background outbox dispatch&quot;,&quot;sort&quot;:&quot;asynchCall&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:75-75&quot;]},{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;content&quot;,&quot;to&quot;:&quot;gateway&quot;,&quot;label&quot;:&quot;PENDING Reel&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:76-76&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;create HTTP response reaches mobile&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;gateway&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;HTTP enriched PENDING Reel&quot;,&quot;sort&quot;:&quot;reply&quot;,&quot;evidence&quot;:[&quot;backend:apps/api-gateway/src/content/content.controller.ts:150-150&quot;]},{&quot;type&quot;:&quot;ref&quot;,&quot;label&quot;:&quot;If returned visibility mismatches, await PATCH; failure sets error.reelCreated=true&quot;,&quot;participants&quot;:[&quot;mobile&quot;,&quot;gateway&quot;],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1304-1313&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;alt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;createReelAsync resolves&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Set createdReel; stop upload retry loop&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:537-538&quot;]}]},{&quot;guard&quot;:&quot;visibility PATCH fails with error.reelCreated&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Set lastError; stop retry despite error&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:539-543&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:537-545&quot;]}]},{&quot;guard&quot;:&quot;create HTTP response lost or request fails before createdReel is assigned&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Catch error without reelCreated marker; next attempt starts fresh upload&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1294-1313&quot;]}]}],&quot;evidence&quot;:[&quot;backend:apps/content-service/src/application/use-cases/create-reel.use-case.ts:28-76&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1289-1313&quot;]}]},{&quot;guard&quot;:&quot;PUT throws&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Catch upload transport error; repeat only if attempt remains&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1283-1287&quot;,&quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1283-1291&quot;]}]},{&quot;guard&quot;:&quot;presign request fails&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Catch presign error; no PUT/create; repeat if attempt remains&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1280-1281&quot;,&quot;mobile:src/hooks/useReelCreator.ts:539-545&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReels.ts:1280-1287&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:531-545&quot;]},{&quot;type&quot;:&quot;frame&quot;,&quot;operator&quot;:&quot;opt&quot;,&quot;operands&quot;:[{&quot;guard&quot;:&quot;!createdReel&quot;,&quot;steps&quot;:[{&quot;type&quot;:&quot;message&quot;,&quot;from&quot;:&quot;mobile&quot;,&quot;to&quot;:&quot;mobile&quot;,&quot;label&quot;:&quot;Show publish failure and return&quot;,&quot;sort&quot;:&quot;synchCall&quot;,&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:547-555&quot;]}]}],&quot;evidence&quot;:[&quot;mobile:src/hooks/useReelCreator.ts:547-555&quot;]}],&quot;notes&quot;:[&quot;Loop uses logical stop conditions equivalent to source for-loop plus break, not an idempotency key. Presign/upload failures skip the later steps inside explicit operands.&quot;,&quot;A server commit followed by lost HTTP response leaves no known reelCreated marker; another attempt generates a different random object key and new Reel/outbox IDs.&quot;,&quot;The storage SDK presigns locally; no fabricated Media-&gt;R2 presign network request. Logical RMQ RPC abstracts envelopes; presign and upload failure operands stop later steps.&quot;,&quot;Current mobile getReelUploadUrl sends fileType only; gateway purpose defaults to chat, so video key uses chat-videos rather than an assumed reels prefix. This is current source behavior, not an app change.&quot;]}" conformance="OMG UML 2.5.1 documented subset" scopeDescription="At most two whole upload/create attempts; fresh object key and Reel/outbox identities can duplicate effects after a lost create response." sourceNotes="[&quot;Loop uses logical stop conditions equivalent to source for-loop plus break, not an idempotency key. Presign/upload failures skip the later steps inside explicit operands.&quot;, &quot;A server commit followed by lost HTTP response leaves no known reelCreated marker; another attempt generates a different random object key and new Reel/outbox IDs.&quot;, &quot;The storage SDK presigns locally; no fabricated Media-&gt;R2 presign network request. Logical RMQ RPC abstracts envelopes; presign and upload failure operands stop later steps.&quot;, &quot;Current mobile getReelUploadUrl sends fileType only; gateway purpose defaults to chat, so video key uses chat-videos rather than an assumed reels prefix. This is current source behavior, not an app change.&quot;]"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s34" value="opt" vertex="1" parent="1" style="shape=umlFrame;html=1;fillColor=none;strokeColor=light-dark(#202020,#eeeeee);strokeWidth=1;fontColor=light-dark(#202020,#